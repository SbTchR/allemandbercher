---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { byOrderThenTitle } from '../../lib/resources';
import { resourceUrl } from '../../lib/resources';

const conseils = (await getCollection('conseils')).sort(byOrderThenTitle);

const adviceActions: Record<string, string> = {
  'Expression écrite': 'Préparer un texte clair et complet',
  'Expression orale': 'Parler avec des phrases utiles',
  'Compréhension écrite': 'Trouver les informations importantes dans un texte',
  'Compréhension orale': 'Repérer l’essentiel à l’écoute',
  Vocabulaire: 'Mémoriser les mots sur la durée',
};
---

<Layout title="Conseils" description="Conseils pour améliorer ses compétences communicatives et préparer les tests.">
  <section class="hero compact-hero">
    <h1>Conseils</h1>
    <p class="lead">Pour améliorer ses compétences communicatives et bien se préparer aux tests</p>
  </section>

  <section class="content-band" aria-label="Compétences travaillées">
    <div class="landing-tile-grid advice-tile-grid">
      {
        conseils.map((entry) => (
          <a class="landing-tile advice-tile" href={resourceUrl(entry)}>
            <h2>{entry.data.title}</h2>
            <span class="tile-action">{adviceActions[entry.data.title] ?? 'Voir les conseils'}</span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

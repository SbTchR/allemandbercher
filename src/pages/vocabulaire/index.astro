---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { chapterLevels, type ChapterItem } from '../../data/chapters';
import { byLevelThenOrder } from '../../lib/resources';
import { resourceUrl } from '../../lib/resources';

const entries = (await getCollection('vocabulaire')).sort(byLevelThenOrder);
const levels = ['9H', '10H', '11H'] as const;
const levelTitles = {
  '9H': 'Geni@l Klick 9H',
  '10H': 'Geni@l Klick 10H',
  '11H': 'Geni@l 11H',
};
const vocabularyBySlug = new Map(
  entries.map((entry) => [entry.id.split('/').pop()?.replace(/\.md$/, ''), entry])
);

function chapterTitle(chapter: ChapterItem) {
  return chapter.label.replace('K', 'Kapitel ');
}
---

<Layout title="Vocabulaire" description="Vocabulaire d’allemand par niveau et par chapitre.">
  <section class="resource-header resource-header-with-callout vocabulary-landing-header">
    <div class="resource-title-block">
      <p class="eyebrow">Mots et expressions</p>
      <h1>Vocabulaire</h1>
    </div>

    <aside class="objective-box vocabulary-intro-box" aria-labelledby="vocabulary-intro-title">
      <div>
        <h2 id="vocabulary-intro-title">Réviser les mots</h2>
        <p>Quizlet, Gimkit, Blooket et application de révision pour apprendre les listes par chapitre.</p>
      </div>
      <div class="vocabulary-tool-actions">
        <a class="text-link" href="https://sbtchr.github.io/AppVoc/">Application faite maison</a>
        <span>Cabuu recommandé</span>
      </div>
    </aside>
  </section>

  {
    levels.map((level) => (
      <section class="content-band" aria-labelledby={`vocabulaire-${level}`}>
        <div class="section-heading">
          <div>
            <p class="eyebrow">Niveau</p>
            <h2 id={`vocabulaire-${level}`}>{levelTitles[level]}</h2>
          </div>
        </div>
        <div class="landing-tile-grid chapter-tile-grid">
          {chapterLevels.find((item) => item.level === level)?.chapters.map((chapter) => {
            const entry = vocabularyBySlug.get(chapter.vocabularySlug);
            if (!entry) return null;

            return (
              <a class="landing-tile chapter-title-tile" href={resourceUrl(entry)}>
                <h3>{chapterTitle(chapter)}</h3>
                <span class="tile-description">{chapter.title}</span>
              </a>
            );
          })}
        </div>
      </section>
    ))
  }
</Layout>

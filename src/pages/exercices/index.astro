---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { byOrderThenTitle, resourceUrl } from '../../lib/resources';
import { chapterLevels, type ChapterItem } from '../../data/chapters';

const exercices = await getCollection('exercices');
const byLevel = {
  'Geni@l Klick 9H': exercices.filter((entry) => entry.data.level === '9H').sort(byOrderThenTitle),
  'Geni@l 10H': exercices.filter((entry) => entry.data.level === '10H').sort(byOrderThenTitle),
  'Geni@l 11H': exercices.filter((entry) => entry.data.level === '11H').sort(byOrderThenTitle),
};

const sectionId = (label: string) => label.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const exerciseBySlug = new Map(
  exercices.map((entry) => [entry.id.split('/').pop()?.replace(/\.md$/, ''), entry])
);

function chapterTitle(chapter: ChapterItem) {
  return `${chapter.label.replace('K', 'Kapitel ')} - ${chapter.title}`;
}
---

<Layout title="Exercices" description="Exercices d’allemand classés par niveau et par chapitre.">
  <section class="hero compact-hero">
    <h1>Geni@l</h1>
  </section>

  {
    Object.entries(byLevel).map(([label, entries]) => {
      const levelData = chapterLevels.find((item) => item.level === entries[0]?.data.level);
      const chapters = levelData?.chapters ?? [];

      return (
      <section class="content-band" aria-labelledby={`exercices-${sectionId(label)}`}>
        <div class="section-heading">
          <div>
            <h2 id={`exercices-${sectionId(label)}`}>{label}</h2>
          </div>
        </div>
        <div class="landing-tile-grid chapter-tile-grid">
          {chapters.map((chapter) => {
            const entry = exerciseBySlug.get(chapter.exerciseSlug);
            if (!entry) return null;

            return (
              <a class="landing-tile chapter-title-tile" href={resourceUrl(entry)}>
                <span>{chapterTitle(chapter)}</span>
              </a>
            );
          })}
        </div>
      </section>
      );
    })
  }
</Layout>

---
import Layout from '../../components/Layout.astro';
import { withBase } from '../../lib/paths';

type ToolAction = {
  label: string;
  href: string;
};

type ToolCard = {
  kicker: string;
  title: string;
  summary: string;
  details: string[];
  actions: ToolAction[];
  open?: boolean;
};

const toolCards: ToolCard[] = [
  {
    kicker: 'Exercices',
    title: 'Geni@l Klick online',
    summary: 'Des exercices complémentaires liés aux chapitres de la méthode.',
    details: [
      'Sélectionne ton année en haut de la page, puis le chapitre sur la gauche.',
      'Choisis la version adaptée à ton niveau : gris, bleu clair ou bleu foncé.',
      'L’onglet “Hörtexte” donne accès aux fichiers audio de l’Arbeitsbuch.',
    ],
    actions: [{ label: 'Ouvrir Geni@l Klick', href: 'http://www.genialklick.ch/' }],
    open: true,
  },
  {
    kicker: 'Vocabulaire',
    title: 'Application faite maison',
    summary: 'La nouvelle application de vocabulaire pour réviser les listes par chapitre.',
    details: ['Utilise-la pour retrouver rapidement les vocabulaires Geni@l Klick et t’entraîner régulièrement.'],
    actions: [{ label: 'Ouvrir AppVoc', href: 'https://sbtchr.github.io/AppVoc/' }],
  },
  {
    kicker: 'Vocabulaire',
    title: 'Quizlet',
    summary: 'Des listes par chapitre avec plusieurs modes d’entraînement.',
    details: [
      'Crée un compte si tu veux garder ta progression.',
      'Privilégie les modes “apprendre” et “écrire” pour réviser efficacement.',
      'Les jeux sont utiles pour varier, mais ils ne remplacent pas une vraie révision.',
    ],
    actions: [
      { label: 'Geni@l Klick 9H', href: 'https://quizlet.com/Sbovat/folders/genil-klick-9h?x=1xqt&i=g2phv' },
      { label: 'Geni@l Klick 10H', href: 'https://quizlet.com/Sbovat/folders/genil-klick-10-11h?x=1xqt&i=g2phv' },
      { label: 'Geni@l Klick 11H', href: 'https://quizlet.com/Sbovat/folders/genil-klick-11h/sets' },
    ],
  },
  {
    kicker: 'Entraînement',
    title: 'Duolingo',
    summary: 'Un complément ludique pour automatiser les structures et le vocabulaire.',
    details: [
      'Utile pour travailler un peu chaque jour.',
      'À utiliser comme complément au cours, pas comme remplacement des exercices de chapitre.',
    ],
    actions: [{ label: 'Ouvrir Duolingo', href: 'http://www.duolingo.com/' }],
  },
  {
    kicker: 'Vidéo',
    title: "Nico's Weg",
    summary: 'De courtes vidéos de Deutsche Welle avec exercices autocorrigés.',
    details: [
      'La série commence avec les bases et monte progressivement.',
      'Regarde les épisodes dans l’ordre quand c’est possible pour suivre l’histoire.',
    ],
    actions: [
      { label: 'Débutant A1', href: 'https://learngerman.dw.com/en/beginners/c-36519789' },
      { label: 'Intermédiaire A2', href: 'https://learngerman.dw.com/en/beginners-with-prior-knowledge/c-36519797' },
      { label: 'Avancé B1', href: 'https://learngerman.dw.com/en/fortgeschrittene/c-36519718' },
    ],
  },
  {
    kicker: 'Outil maison',
    title: 'NAD-Maschine',
    summary: 'Un outil pour travailler certaines structures de phrase.',
    details: ['Accède directement à la page intégrée au site.'],
    actions: [{ label: 'Ouvrir la NAD-Maschine', href: withBase('/outils-en-ligne/nad-maschine/') }],
  },
];

const dictionaries = [
  {
    title: 'LEO',
    href: 'http://www.leo.org/',
    note: 'Très complet, avec forum pour les traductions et les usages précis.',
  },
  {
    title: 'Pons',
    href: 'http://www.pons.com/',
    note: 'Dictionnaire complet avec exemples d’expressions.',
  },
  {
    title: 'Google Traduction',
    href: 'http://translate.google.com/',
    note: 'Utile pour comprendre un texte, mais à éviter pour produire une phrase à ton niveau.',
  },
];

const smartphoneApps = [
  'Duolingo',
  'Quizlet',
  'LEO',
  "DW Learn German / Nico's Weg",
  'Mein Weg nach Deutschland',
  'Lernabenteuer Deutsch',
  'LyricsTraining',
  'ChatGPT ou Google Gemini pour l’expression orale',
];
---

<Layout title="Outils en ligne" description="Outils en ligne utiles pour apprendre l’allemand.">
  <section class="resource-header resource-header-with-callout">
    <div class="resource-title-block">
      <p class="eyebrow">Ressources externes</p>
      <h1>Outils en ligne</h1>
    </div>

    <aside class="objective-box landing-intro-box" aria-labelledby="tools-intro-title">
      <h2 id="tools-intro-title">Choisir le bon outil</h2>
      <p>Des sites utiles pour s’entraîner, réviser le vocabulaire, vérifier un mot ou compléter le travail fait en classe.</p>
    </aside>
  </section>

  <section class="content-band tools-landing-panel" aria-labelledby="tools-main-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Accès rapide</p>
        <h2 id="tools-main-title">Outils principaux</h2>
      </div>
    </div>

    <div class="tool-card-grid">
      {
        toolCards.map((tool) => (
          <details class="tool-card" open={tool.open}>
            <summary>
              <span class="card-kicker">{tool.kicker}</span>
              <strong>{tool.title}</strong>
              <span>{tool.summary}</span>
            </summary>
            <div class="tool-card-content">
              <ul>
                {tool.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
              <div class="tool-action-grid">
                {tool.actions.map((action) => (
                  <a class="text-link" href={action.href}>{action.label}</a>
                ))}
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </section>

  <section class="content-band" aria-labelledby="dictionary-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Traduction</p>
        <h2 id="dictionary-title">Dictionnaires en ligne</h2>
      </div>
    </div>
    <div class="dictionary-grid">
      {
        dictionaries.map((dictionary) => (
          <a class="dictionary-card" href={dictionary.href}>
            <strong>{dictionary.title}</strong>
            <span>{dictionary.note}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="content-band apps-panel" aria-labelledby="apps-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Smartphone</p>
        <h2 id="apps-title">Applications utiles</h2>
      </div>
    </div>
    <div class="app-chip-grid">
      {smartphoneApps.map((app) => <span>{app}</span>)}
    </div>
  </section>
</Layout>

---
import { externalLinkGroups } from '../data/grammarTheory';

const quizItems = [
  {
    prompt: 'Quelle forme complète la phrase ?',
    sentence: '___ Schülerin schreibt eine Nachricht.',
    choices: ['Die', 'Den', 'Der'],
    answer: 'Die',
    feedback: 'Schülerin est le sujet : féminin nominatif = die Schülerin.',
  },
  {
    prompt: 'Quelle forme complète la phrase ?',
    sentence: 'Ich sehe ___ Schüler.',
    choices: ['der', 'den', 'dem'],
    answer: 'den',
    feedback: 'Je vois qui ? den Schüler : masculin accusatif.',
  },
  {
    prompt: 'Quelle forme complète la phrase ?',
    sentence: 'Die Lehrerin hilft ___ Kind.',
    choices: ['das', 'dem', 'den'],
    answer: 'dem',
    feedback: 'helfen demande le datif : neutre datif = dem Kind.',
  },
];

const caseExternalGroups = externalLinkGroups['les-cas-theorie-de-base'];
---

<section class="content-band cases-practice-suite" aria-labelledby="cases-practice-title" data-cases-practice>
  <div class="cases-practice-header">
    <p class="home-section-label">Exercice intégré</p>
    <h2 id="cases-practice-title">Trouve le bon cas</h2>
    <p>Repère d’abord le rôle du groupe, puis choisis la forme correcte.</p>
  </div>

  <article class="case-final-quiz" data-case-final-quiz>
    <div class="case-practice-title-row">
      <div>
        <p class="case-practice-kicker">Trois phrases</p>
        <h3>Nominatif, accusatif ou datif ?</h3>
      </div>
      <output data-final-score aria-live="polite">0 / {quizItems.length}</output>
    </div>

    <div class="case-final-grid">
      {
        quizItems.map((item, index) => (
          <section class="case-final-item" data-final-item>
            <p>
              <strong>{index + 1}.</strong> {item.prompt}
            </p>
            <blockquote>{item.sentence}</blockquote>
            <div class="grammar-choice-row" role="group" aria-label={`Réponses pour la phrase ${index + 1}`}>
              {
                item.choices.map((choice) => (
                  <button class="grammar-choice" type="button" data-final-choice data-correct={choice === item.answer ? 'true' : 'false'}>
                    {choice}
                  </button>
                ))
              }
            </div>
            <p class="grammar-feedback" data-final-feedback data-success={item.feedback} aria-live="polite"></p>
          </section>
        ))
      }
    </div>

    <div class="case-practice-actions">
      <button class="text-link" type="button" data-reset-cases>Recommencer</button>
    </div>
  </article>

  <details class="external-quest case-external-quest">
    <summary>Exercices externes supplémentaires</summary>
    <div class="external-link-sections">
      {
        caseExternalGroups.map((group) => (
          <section>
            <h3>{group.title}</h3>
            <div class="external-button-grid">
              {group.links.map((link) => (
                <a href={link.url} target="_blank" rel="noreferrer">
                  {link.label}
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </details>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-cases-practice]').forEach((practice) => {
    const quiz = practice.querySelector<HTMLElement>('[data-case-final-quiz]');
    if (!quiz) return;

    const items = Array.from(quiz.querySelectorAll<HTMLElement>('[data-final-item]'));
    const score = quiz.querySelector<HTMLOutputElement>('[data-final-score]');

    const updateScore = () => {
      const correct = items.filter((item) => item.dataset.state === 'correct').length;
      if (score) score.textContent = `${correct} / ${items.length}`;
    };

    items.forEach((item) => {
      const buttons = Array.from(item.querySelectorAll<HTMLButtonElement>('[data-final-choice]'));
      const feedback = item.querySelector<HTMLElement>('[data-final-feedback]');

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const isCorrect = button.dataset.correct === 'true';
          buttons.forEach((choice) => choice.classList.remove('is-correct', 'is-wrong'));
          button.classList.add(isCorrect ? 'is-correct' : 'is-wrong');
          item.dataset.state = isCorrect ? 'correct' : 'wrong';

          if (feedback) {
            feedback.textContent = isCorrect
              ? feedback.dataset.success ?? 'Correct.'
              : 'Pas encore. Repère le rôle du groupe et réessaie.';
            feedback.classList.toggle('is-correct', isCorrect);
            feedback.classList.toggle('is-wrong', !isCorrect);
          }

          updateScore();
        });
      });
    });

    practice.querySelector<HTMLButtonElement>('[data-reset-cases]')?.addEventListener('click', () => {
      items.forEach((item) => {
        delete item.dataset.state;
        item.querySelectorAll<HTMLButtonElement>('[data-final-choice]').forEach((button) => {
          button.classList.remove('is-correct', 'is-wrong');
        });
        const feedback = item.querySelector<HTMLElement>('[data-final-feedback]');
        if (feedback) {
          feedback.textContent = '';
          feedback.classList.remove('is-correct', 'is-wrong');
        }
      });
      updateScore();
    });

    updateScore();
  });
</script>

---
import { withBase } from '../lib/paths';

const steps = [
  { href: '#consignes', number: '1', label: 'Les consignes' },
  { href: '#se-presenter', number: '2', label: 'Se présenter' },
  { href: '#questions', number: '3', label: 'Les questions' },
  { href: '#salles', number: '4', label: 'Situer les salles' },
  { href: '#metiers', number: '5', label: 'Les métiers' },
];
---

<div class="k1-journey">
  <nav class="k1-progress" aria-label="Les cinq étapes du Kapitel 1">
    <p><strong>5 étapes pour progresser</strong><span>Avance dans l’ordre du chapitre.</span></p>
    <ol>
      {steps.map((step) => <li><a href={step.href}><span aria-hidden="true">{step.number}</span>{step.label}</a></li>)}
    </ol>
  </nav>

  <section class="k1-step" id="consignes" aria-labelledby="consignes-title">
    <header class="k1-step-header"><span class="k1-step-number" aria-hidden="true">1</span><div><p>En classe</p><h2 id="consignes-title">Comprendre les consignes</h2></div><span class="k1-source">Kursbuch 2 · p. 8 <small>AB 3–4 · p. 8</small></span></header>
    <div class="k1-learning-grid">
      <article class="k1-help">
        <p class="k1-card-label">Le coup de pouce</p><h3>L’impératif avec <span lang="de">ihr</span></h3>
        <p>On enlève simplement le pronom <span lang="de">ihr</span>. Le verbe garde la même forme.</p>
        <p class="k1-rule" lang="de"><span>ihr ergänzt</span><b>→</b><strong>Ergänzt!</strong></p>
        <ul class="k1-phrase-bank" lang="de"><li>Ich verstehe das nicht.</li><li>Können Sie das bitte wiederholen?</li><li>Wie kann man das auf Deutsch sagen?</li></ul>
        <a class="text-link" href={withBase('/theorie/conjugaison/imperatif/')}>Voir la théorie : l’impératif</a>
      </article>
      <form class="k1-practice" data-k1-exercise>
        <p class="k1-card-label">À toi de jouer</p>
        <fieldset><legend>Transforme la forme avec <span lang="de">ihr</span> en consigne.</legend>
          <label><span lang="de">ihr macht eine Liste</span><select data-answer="Macht!" aria-label="Impératif de ihr macht"><option value="">Choisir…</option><option>Macht!</option><option>Machen!</option><option>Mach!</option></select></label>
          <label><span lang="de">ihr lest den Text</span><select data-answer="Lest!" aria-label="Impératif de ihr lest"><option value="">Choisir…</option><option>Lesen!</option><option>Lest!</option><option>Lies!</option></select></label>
          <label><span lang="de">ihr kommt an die Tafel</span><select data-answer="Kommt!" aria-label="Impératif de ihr kommt"><option value="">Choisir…</option><option>Komm!</option><option>Kommt!</option><option>Kommen!</option></select></label>
        </fieldset>
        <div class="k1-actions"><button type="button" data-check>Vérifier</button><output aria-live="polite">Choisis une réponse pour chaque consigne.</output></div>
        <details class="k1-hint"><summary>Besoin d’un indice ?</summary><p>Cache le pronom <span lang="de">ihr</span> : la forme verbale qui reste devient la consigne.</p></details>
      </form>
      <article class="k1-reuse"><p class="k1-card-label">Je réutilise</p><h3>Micro-dialogue en classe</h3><p>Choisis une consigne et réponds comme un élève qui a besoin d’aide.</p><blockquote lang="de">Lehrerin: Öffnet das Buch.<br />Du: Können Sie das bitte wiederholen?</blockquote><label>Écris ton mini-dialogue<textarea data-draft="consignes" rows="4" placeholder="Lehrer/in: …&#10;Ich: …"></textarea></label></article>
    </div>
  </section>

  <section class="k1-step" id="se-presenter" aria-labelledby="presentation-title">
    <header class="k1-step-header"><span class="k1-step-number" aria-hidden="true">2</span><div><p>Faire connaissance</p><h2 id="presentation-title">Se présenter et présenter quelqu’un</h2></div><span class="k1-source">Kursbuch 3–5 · p. 8–9 <small>AB 5–6 · p. 9</small></span></header>
    <div class="k1-learning-grid">
      <article class="k1-help">
        <p class="k1-card-label">Les phrases utiles</p><h3>Question → réponse</h3>
        <dl class="k1-models"><div><dt lang="de">Wie heisst du?</dt><dd lang="de">Ich heisse Noa.</dd></div><div><dt lang="de">Wie alt bist du?</dt><dd lang="de">Ich bin 13 Jahre alt.</dd></div><div><dt lang="de">Wo wohnst du?</dt><dd lang="de">Ich wohne in Bercher.</dd></div><div><dt lang="de">Welche Sprachen sprichst du?</dt><dd lang="de">Ich spreche Französisch und Deutsch.</dd></div></dl>
        <div class="k1-theory-links"><a class="text-link" href={withBase('/theorie/conjugaison/present/')}>Le présent</a><a class="text-link" href={withBase('/theorie/grammaire/les-pronoms-possessifs/')}>sein / ihr</a></div>
      </article>
      <form class="k1-practice" data-k1-exercise>
        <p class="k1-card-label">Le profil de Mila</p>
        <fieldset><legend>Choisis la phrase qui présente correctement Mila.</legend><p class="k1-profile"><strong>Mila Keller</strong><span>13 ans · Payerne · allemand et français · natation</span></p>
          <label><span>Nom</span><select data-answer="Sie heisst Mila Keller."><option value="">Choisir…</option><option>Ich heisse Mila Keller.</option><option>Sie heisst Mila Keller.</option><option>Ihr heisst Mila Keller.</option></select></label>
          <label><span>Langues</span><select data-answer="Sie spricht Deutsch und Französisch."><option value="">Choisir…</option><option>Sie sprecht Deutsch und Französisch.</option><option>Sie spricht Deutsch und Französisch.</option><option>Ich spreche Deutsch und Französisch.</option></select></label>
          <label><span>Loisir</span><select data-answer="Ihr Hobby ist Schwimmen."><option value="">Choisir…</option><option>Sein Hobby ist Schwimmen.</option><option>Ihre Hobby sind Schwimmen.</option><option>Ihr Hobby ist Schwimmen.</option></select></label>
        </fieldset>
        <div class="k1-actions"><button type="button" data-check>Vérifier</button><output aria-live="polite">Observe bien qui est présenté.</output></div><details class="k1-hint"><summary>Besoin d’un indice ?</summary><p>Pour une fille : <span lang="de">sie</span> et <span lang="de">ihr Hobby</span>.</p></details>
      </form>
      <article class="k1-reuse"><p class="k1-card-label">Je réutilise</p><h3>Ma carte de présentation</h3><p>Parle de toi, puis transforme deux phrases pour présenter une autre personne.</p><p class="k1-starters" lang="de">Ich heisse … · Ich wohne … · Meine Hobbys sind …<br />Das ist … · Er/Sie kommt aus …</p><label>Prépare ta présentation<textarea data-draft="presentation" rows="5" placeholder="Ich heisse …"></textarea></label></article>
    </div>
  </section>

  <section class="k1-step" id="questions" aria-labelledby="questions-title">
    <header class="k1-step-header"><span class="k1-step-number" aria-hidden="true">3</span><div><p>La nouvelle école</p><h2 id="questions-title">Poser les bonnes questions</h2></div><span class="k1-source">Kursbuch 6–7 · p. 10–11 <small>AB 7 · p. 10</small></span></header>
    <div class="k1-learning-grid">
      <article class="k1-help"><p class="k1-card-label">Deux constructions</p><h3><span lang="de">Ja/Nein</span> ou mot interrogatif ?</h3><p class="k1-rule" lang="de"><span>Hast</span><b>du</b><strong>heute Sport?</strong></p><p class="k1-rule" lang="de"><span>Wann</span><b>hast</b><strong>du Sport?</strong></p><p>Dans une question oui/non, le verbe vient d’abord. Dans une <span lang="de">W-Frage</span>, le mot interrogatif ouvre la question.</p><p class="k1-word-row" lang="de">Wer? · Was? · Wo? · Wann? · Wie? · Wie viele? · Welche?</p><a class="text-link" href={withBase('/theorie/syntaxe/les-questions/')}>Voir la théorie : les questions</a></article>
      <form class="k1-practice" data-k1-exercise><p class="k1-card-label">Repère la construction</p><fieldset><legend>Classe les questions sur la nouvelle école.</legend>
        <label><span lang="de">Ist deine Klasse gross?</span><select data-answer="Ja/Nein-Frage"><option value="">Choisir…</option><option>Ja/Nein-Frage</option><option>W-Frage</option></select></label>
        <label><span lang="de">Wann beginnt die Schule?</span><select data-answer="W-Frage"><option value="">Choisir…</option><option>Ja/Nein-Frage</option><option>W-Frage</option></select></label>
        <label><span lang="de">Habt ihr einen Computerraum?</span><select data-answer="Ja/Nein-Frage"><option value="">Choisir…</option><option>Ja/Nein-Frage</option><option>W-Frage</option></select></label>
        <label><span lang="de">Wer ist dein Klassenlehrer?</span><select data-answer="W-Frage"><option value="">Choisir…</option><option>Ja/Nein-Frage</option><option>W-Frage</option></select></label>
        </fieldset><div class="k1-actions"><button type="button" data-check>Vérifier</button><output aria-live="polite">Regarde le premier mot de chaque question.</output></div><details class="k1-hint"><summary>Besoin d’un indice ?</summary><p>Si la réponse peut commencer par <span lang="de">ja</span> ou <span lang="de">nein</span>, c’est une <span lang="de">Ja/Nein-Frage</span>.</p></details></form>
      <article class="k1-reuse"><p class="k1-card-label">Je réutilise</p><h3>Interview : premier jour</h3><p>Prépare une question oui/non et deux questions avec un mot interrogatif.</p><p class="k1-starters" lang="de">Ist …? · Habt ihr …? · Wann …? · Wer …?</p><label>Mes questions<textarea data-draft="questions" rows="5" placeholder="Ist deine Klasse …?"></textarea></label></article>
    </div>
  </section>

  <section class="k1-step" id="salles" aria-labelledby="salles-title">
    <header class="k1-step-header"><span class="k1-step-number" aria-hidden="true">4</span><div><p>Dans l’école</p><h2 id="salles-title">Situer les salles avec <span lang="de">wo?</span></h2></div><span class="k1-source">Kursbuch 7–8 · p. 11 <small>AB 8–9 · p. 11</small></span></header>
    <div class="k1-learning-grid">
      <article class="k1-help"><p class="k1-card-label">Les chunks à retenir</p><h3><span lang="de">im</span>, <span lang="de">in der</span> et <span lang="de">neben</span></h3><div class="k1-location-rules"><p><span lang="de">der / das</span><strong lang="de">im</strong><small lang="de">im Computerraum</small></p><p><span lang="de">die</span><strong lang="de">in der</strong><small lang="de">in der Bibliothek</small></p><p><span lang="de">X ist …</span><strong lang="de">neben</strong><small lang="de">neben der Turnhalle</small></p></div><p class="k1-note">Ici, on décrit une position sans déplacement. <span lang="de">Neben</span> est appris comme un bloc utile.</p><div class="k1-theory-links"><a class="text-link" href={withBase('/theorie/grammaire/les-prepositions/')}>Les prépositions</a><a class="text-link" href={withBase('/theorie/grammaire/les-cas-theorie-de-base/')}>Les cas</a></div></article>
      <form class="k1-practice" data-k1-exercise><p class="k1-card-label">Le plan de l’école</p><div class="k1-school-map" aria-label="Plan d’une école fictive"><span class="room library">Bibliothek<small>rez</small></span><span class="room gym">Turnhalle<small>sport</small></span><span class="room lab">Computerraum<small>1. Stock</small></span><span class="room office">Sekretariat<small>Erdgeschoss</small></span></div><fieldset><legend>Complète les localisations.</legend>
        <label><span lang="de">Wir lesen ___ Bibliothek.</span><select data-answer="in der"><option value="">Choisir…</option><option>im</option><option>in der</option><option>neben</option></select></label>
        <label><span lang="de">Der Computerraum ist ___ ersten Stock.</span><select data-answer="im"><option value="">Choisir…</option><option>im</option><option>in der</option><option>neben der</option></select></label>
        <label><span lang="de">Die Bibliothek ist ___ Turnhalle.</span><select data-answer="neben der"><option value="">Choisir…</option><option>im</option><option>in der</option><option>neben der</option></select></label>
        </fieldset><div class="k1-actions"><button type="button" data-check>Vérifier</button><output aria-live="polite">Observe le genre du lieu et le plan.</output></div><details class="k1-hint"><summary>Besoin d’un indice ?</summary><p><span lang="de">Die Bibliothek</span> demande <span lang="de">in der</span>. Pour dire « à côté de la salle de sport », utilise tout le bloc <span lang="de">neben der Turnhalle</span>.</p></details></form>
      <article class="k1-reuse"><p class="k1-card-label">Je réutilise</p><h3>Décris ton école</h3><p>Choisis une salle. Dis à quel étage elle se trouve, ce qu’on y fait et quelle salle est à côté.</p><p class="k1-starters" lang="de">Der/Die … ist im/in der …<br />Dort … wir. · Neben … ist …</p><label>Ma description<textarea data-draft="salles" rows="5" placeholder="Die Bibliothek ist …"></textarea></label></article>
    </div>
  </section>

  <section class="k1-step" id="metiers" aria-labelledby="metiers-title">
    <header class="k1-step-header"><span class="k1-step-number" aria-hidden="true">5</span><div><p>Les personnes de l’école</p><h2 id="metiers-title">Comprendre qui fait quoi</h2></div><span class="k1-source">Kursbuch 9–10 · p. 12 <small>AB 10–11 · p. 12</small></span></header>
    <div class="k1-learning-grid">
      <article class="k1-help"><p class="k1-card-label">Le lexique en action</p><h3>Personne + activité</h3><ul class="k1-jobs" lang="de"><li><strong>der Lehrer / die Lehrerin</strong><span>unterrichtet</span></li><li><strong>der Koch / die Köchin</strong><span>kocht</span></li><li><strong>die Sekretärin</strong><span>arbeitet im Sekretariat</span></li><li><strong>der Hauswart</strong><span>repariert</span></li></ul><p class="k1-starters" lang="de">Was machen Sie? · Wo arbeiten Sie? · Wann arbeiten Sie?</p><a class="text-link" href={withBase('/theorie/syntaxe/les-questions/')}>Revoir les questions d’interview</a></article>
      <form class="k1-practice" data-k1-exercise><p class="k1-card-label">Qui parle ?</p><fieldset><legend>Associe chaque réponse au métier.</legend>
        <label><span lang="de">« Ich unterrichte Deutsch. »</span><select data-answer="die Lehrerin"><option value="">Choisir…</option><option>die Sekretärin</option><option>die Lehrerin</option><option>der Hauswart</option></select></label>
        <label><span lang="de">« Ich repariere eine Tür. »</span><select data-answer="der Hauswart"><option value="">Choisir…</option><option>der Koch</option><option>der Hauswart</option><option>der Direktor</option></select></label>
        <label><span lang="de">« Ich koche das Mittagessen. »</span><select data-answer="der Koch"><option value="">Choisir…</option><option>der Koch</option><option>der Lehrer</option><option>der Sekretär</option></select></label>
        </fieldset><div class="k1-actions"><button type="button" data-check>Vérifier</button><output aria-live="polite">Cherche l’activité qui caractérise chaque métier.</output></div><details class="k1-hint"><summary>Besoin d’un indice ?</summary><p><span lang="de">unterrichten</span> = enseigner, <span lang="de">reparieren</span> = réparer, <span lang="de">kochen</span> = cuisiner.</p></details></form>
      <article class="k1-reuse"><p class="k1-card-label">Je réutilise</p><h3>Mini-interview</h3><p>Choisis une personne de l’école. Pose-lui des questions, puis présente-la à la classe.</p><p class="k1-starters" lang="de">Was machen Sie? · Wo arbeiten Sie?<br />Das ist … Er/Sie arbeitet …</p><label>Mon interview<textarea data-draft="metiers" rows="5" placeholder="Frage: Was machen Sie?&#10;Antwort: …"></textarea></label></article>
    </div>
  </section>

  <section class="k1-checkpoint" aria-labelledby="checkpoint-title">
    <div><p class="k1-card-label">Bilan du Kapitel 1</p><h2 id="checkpoint-title">Je fais le point</h2><p>Les exercices réussis s’affichent automatiquement. Tu peux aussi cocher ce que tu sais faire sans aide.</p></div>
    <output class="k1-score" data-k1-score aria-live="polite"><strong>0 / 5</strong><span>étape réussie</span></output>
    <ul><li><label><input type="checkbox" /> Je comprends les consignes de classe.</label></li><li><label><input type="checkbox" /> Je peux me présenter et présenter quelqu’un.</label></li><li><label><input type="checkbox" /> Je sais poser des questions simples.</label></li><li><label><input type="checkbox" /> Je situe une salle avec <span lang="de">im</span>, <span lang="de">in der</span> et <span lang="de">neben</span>.</label></li><li><label><input type="checkbox" /> Je peux parler d’une personne de l’école.</label></li></ul>
  </section>
</div>

<script>
  const exercises = Array.from(document.querySelectorAll<HTMLElement>('[data-k1-exercise]'));
  const score = document.querySelector<HTMLOutputElement>('[data-k1-score]');
  const updateScore = () => { const completed = exercises.filter((exercise) => exercise.dataset.complete === 'true').length; if (score) score.innerHTML = `<strong>${completed} / ${exercises.length}</strong><span>${completed > 1 ? 'étapes réussies' : 'étape réussie'}</span>`; };
  exercises.forEach((exercise) => {
    const button = exercise.querySelector<HTMLButtonElement>('[data-check]'); const output = exercise.querySelector<HTMLOutputElement>('output'); const selects = Array.from(exercise.querySelectorAll<HTMLSelectElement>('select[data-answer]'));
    button?.addEventListener('click', () => {
      let correct = 0; let unanswered = 0;
      selects.forEach((select) => { const isCorrect = select.value === select.dataset.answer; if (!select.value) unanswered += 1; if (isCorrect) correct += 1; select.classList.toggle('is-correct', isCorrect); select.classList.toggle('is-wrong', Boolean(select.value) && !isCorrect); });
      const done = correct === selects.length; exercise.dataset.complete = String(done);
      if (output) { output.className = done ? 'is-correct' : 'is-wrong'; output.textContent = done ? 'Bravo ! Toute l’étape est réussie.' : unanswered > 0 ? `Complète encore ${unanswered} réponse${unanswered > 1 ? 's' : ''}.` : `${correct} réponse${correct > 1 ? 's' : ''} correcte${correct > 1 ? 's' : ''}. Corrige les cases rouges.`; }
      updateScore();
    });
  });
  document.querySelectorAll<HTMLTextAreaElement>('textarea[data-draft]').forEach((field) => { const key = `allemandbercher-k1-${field.dataset.draft}`; try { field.value = localStorage.getItem(key) ?? ''; } catch {} field.addEventListener('input', () => { try { localStorage.setItem(key, field.value); } catch {} }); });
</script>

<style>
  .k1-journey{display:grid;gap:28px}.k1-progress,.k1-step,.k1-checkpoint{border:2px solid var(--border);border-radius:var(--radius-lg);background:rgba(255,255,255,.94);box-shadow:0 10px 0 rgba(15,26,49,.07),0 18px 36px rgba(21,36,72,.09)}.k1-progress{padding:18px}.k1-progress>p{display:flex;justify-content:space-between;gap:12px;margin:0 0 14px;color:var(--muted)}.k1-progress>p strong{color:var(--ink);font-size:1.05rem}.k1-progress ol{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:0;padding:0;list-style:none}.k1-progress a{display:grid;min-height:76px;place-items:center;align-content:center;gap:5px;padding:9px;border-radius:12px;color:var(--ink);font-size:.82rem;font-weight:900;line-height:1.15;text-align:center;text-decoration:none}.k1-progress a:hover{background:var(--accent-yellow-soft)}.k1-progress a span{display:grid;width:28px;height:28px;place-items:center;border-radius:50%;background:var(--accent);color:#fff;font-size:.9rem}.k1-progress li:not(:last-child) a{border-right:2px solid var(--border);border-radius:0}.k1-step{scroll-margin-top:120px;overflow:hidden}.k1-step-header{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:14px;padding:18px 20px;border-bottom:2px solid var(--border)}.k1-step-header p,.k1-step-header h2{margin:0}.k1-step-header p{color:var(--accent);font-size:.76rem;font-weight:950;letter-spacing:.08em;text-transform:uppercase}.k1-step-header h2{color:var(--ink);font-size:clamp(1.3rem,2.5vw,1.9rem);line-height:1.15}.k1-step-number{display:grid;width:48px;height:48px;place-items:center;border-radius:13px;background:var(--accent);box-shadow:0 5px 0 rgba(15,26,49,.14);color:#fff;font-size:1.45rem;font-weight:950}.k1-source{padding:8px 11px;border:2px solid rgba(217,4,41,.22);border-radius:10px;color:var(--ink);font-size:.82rem;font-weight:950;line-height:1.2;text-align:right}.k1-source small{display:block;margin-top:3px;color:var(--muted);font-size:.72rem}.k1-learning-grid{display:grid;grid-template-columns:minmax(220px,.85fr) minmax(320px,1.35fr) minmax(220px,.9fr);gap:14px;padding:18px}.k1-help,.k1-practice,.k1-reuse{min-width:0;margin:0;padding:17px;border:2px solid var(--border);border-radius:14px}.k1-help{background:var(--bg)}.k1-practice{background:#fff}.k1-reuse{background:#fff9e8}.k1-card-label{margin:0 0 8px;color:var(--accent);font-size:.74rem;font-weight:950;letter-spacing:.08em;text-transform:uppercase}.k1-help h3,.k1-reuse h3{margin:0 0 10px;color:var(--ink);font-size:1.08rem;line-height:1.2}.k1-help p,.k1-reuse p{margin:0 0 12px;color:#27334f}.k1-rule{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:7px;padding:10px;border-radius:10px;background:#fff;text-align:center}.k1-rule span{color:var(--grammar-verb);font-weight:900}.k1-rule strong{color:var(--grammar-dative)}.k1-phrase-bank{margin:12px 0 16px;padding-left:20px}.k1-theory-links{display:flex;flex-wrap:wrap;gap:8px}.k1-models{display:grid;gap:8px;margin:0 0 16px}.k1-models div{padding:9px 10px;border-left:4px solid var(--accent-2);background:#fff}.k1-models dt{color:var(--ink);font-weight:900}.k1-models dd{margin:2px 0 0;color:var(--muted)}.k1-practice fieldset{display:grid;gap:10px;margin:0;padding:0;border:0}.k1-practice legend{margin-bottom:12px;color:var(--ink);font-weight:850}.k1-practice label{display:grid;grid-template-columns:minmax(0,1fr) minmax(135px,.8fr);align-items:center;gap:10px;color:#27334f;font-weight:780}.k1-practice select{width:100%;min-height:44px;border:2px solid rgba(31,42,68,.18);border-radius:10px;background:#fff;color:var(--ink);padding:7px 9px;font:inherit}.k1-practice select.is-correct{border-color:var(--grammar-dative);background:var(--grammar-dative-soft)}.k1-practice select.is-wrong{border-color:var(--accent);background:var(--accent-soft)}.k1-actions{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:10px;margin-top:14px}.k1-actions button{min-height:44px;border:2px solid rgba(15,26,49,.16);border-radius:11px;b
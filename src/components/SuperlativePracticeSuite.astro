---
const items = [
  {
    prompt: 'Lena est la plus rapide des trois élèves.',
    parts: ['Von den drei Schülerinnen läuft Lena ', '.'],
    gaps: [{ answer: 'am schnellsten', aliases: [] }],
  },
  {
    prompt: 'En hiver, février est souvent le mois le plus froid.',
    parts: ['Im Winter ist der Februar oft ', '.'],
    gaps: [{ answer: 'am kältesten', aliases: ['am kaeltesten'] }],
  },
  {
    prompt: 'Sarah est la meilleure en mathématiques.',
    parts: ['Sarah ist in Mathe ', '.'],
    gaps: [{ answer: 'am besten', aliases: [] }],
  },
  {
    prompt: 'L’Everest est la plus haute montagne du monde.',
    parts: ['Der Everest ist ', ' Berg der Welt.'],
    gaps: [{ answer: 'der höchste', aliases: ['der hoechste'] }],
  },
  {
    prompt: 'Markus a les plus grandes chaussures de la classe.',
    parts: ['Markus hat ', ' Schuhe in der Klasse.'],
    gaps: [{ answer: 'die grössten', aliases: ['die groessten', 'die größten'] }],
  },
  {
    prompt: 'Quel pays du monde compte le plus d’habitants ?',
    parts: ['Welches Land der Welt hat ', ' Einwohner?'],
    gaps: [{ answer: 'die meisten', aliases: [] }],
  },
];

const gapCount = items.reduce((count, item) => count + item.gaps.length, 0);
const wordBank = items.flatMap((item) => item.gaps.map((gap) => gap.answer));
---

<section
  class="content-band comparative-exercise superlative-gap-exercise"
  aria-labelledby="superlative-practice-title"
  data-superlative-gap-exercise
>
  <div class="comparative-exercise-header">
    <div>
      <p class="home-section-label">Exercice intégré</p>
      <h2 id="superlative-practice-title">Choisis la bonne forme du superlatif</h2>
      <p>Regarde si un nom suit directement, puis complète chaque phrase. Les écritures ae, oe et ue sont acceptées.</p>
    </div>
    <output class="comparative-score" data-superlative-score aria-live="polite">0 / {gapCount}</output>
  </div>

  <div class="comparative-workspace">
    <div class="comparative-items">
      {
        items.map((item, itemIndex) => (
          <article class="comparative-item" data-superlative-item>
            <p class="comparative-prompt">
              <strong>{itemIndex + 1}.</strong> {item.prompt}
            </p>
            <p class="comparative-sentence">
              {item.parts.map((part, partIndex) => (
                <>
                  {part}
                  {item.gaps[partIndex] && (
                    <input
                      class="comparative-gap superlative-gap"
                      type="text"
                      inputmode="text"
                      autocomplete="off"
                      autocapitalize="off"
                      spellcheck="false"
                      aria-label={`Réponse ${itemIndex + 1}.${partIndex + 1}`}
                      data-answer={[item.gaps[partIndex].answer, ...item.gaps[partIndex].aliases].join('|')}
                    />
                  )}
                </>
              ))}
            </p>
            <div class="comparative-item-footer">
              <button class="text-link" type="button" data-check-superlative data-check-superlative-item>
                Vérifier cette phrase
              </button>
              <p class="comparative-feedback" data-superlative-feedback aria-live="polite"></p>
            </div>
          </article>
        ))
      }
    </div>

    <aside class="comparative-side" aria-label="Mots et actions">
      <div class="comparative-word-bank" aria-label="Formes disponibles">
        {wordBank.map((word) => <button type="button" data-superlative-word={word}>{word}</button>)}
      </div>

      <div class="comparative-actions">
        <button class="text-link" type="button" data-reveal-superlative hidden>Voir le corrigé</button>
        <button class="text-link" type="button" data-reset-superlative>Recommencer</button>
      </div>
    </aside>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-superlative-gap-exercise]').forEach((exercise) => {
    const gaps = Array.from(exercise.querySelectorAll<HTMLInputElement>('.superlative-gap'));
    const wordButtons = Array.from(exercise.querySelectorAll<HTMLButtonElement>('[data-superlative-word]'));
    const score = exercise.querySelector<HTMLOutputElement>('[data-superlative-score]');
    const revealButton = exercise.querySelector<HTMLButtonElement>('[data-reveal-superlative]');
    let activeGap = gaps[0];

    const normalize = (value: string) =>
      value
        .trim()
        .toLowerCase()
        .normalize('NFC')
        .replace(/\s+/g, ' ')
        .replace(/ä/g, 'ae')
        .replace(/ö/g, 'oe')
        .replace(/ü/g, 'ue')
        .replace(/ß/g, 'ss');

    const acceptedAnswers = (input: HTMLInputElement) =>
      String(input.dataset.answer ?? '')
        .split('|')
        .filter(Boolean)
        .map(normalize);

    const primaryAnswer = (input: HTMLInputElement) => String(input.dataset.answer ?? '').split('|')[0] ?? '';

    const itemIsComplete = (item: Element) =>
      Array.from(item.querySelectorAll<HTMLInputElement>('.superlative-gap')).every(
        (gap) => normalize(gap.value) !== '',
      );

    const updateScore = () => {
      const correct = gaps.filter((gap) => gap.classList.contains('is-correct')).length;
      if (score) score.textContent = `${correct} / ${gaps.length}`;
    };

    const updateRevealVisibility = () => {
      if (revealButton) {
        revealButton.hidden = !exercise.querySelector('[data-superlative-item][data-checked="true"]');
      }
    };

    const updateWordUsage = () => {
      const usedButtonIndexes = new Set<number>();
      const filledValues = gaps.map((gap) => normalize(gap.value)).filter(Boolean);

      filledValues.forEach((value) => {
        const buttonIndex = wordButtons.findIndex((button, index) => {
          return !usedButtonIndexes.has(index) && normalize(button.dataset.superlativeWord ?? '') === value;
        });
        if (buttonIndex >= 0) usedButtonIndexes.add(buttonIndex);
      });

      wordButtons.forEach((button, index) => {
        button.classList.toggle('is-used', usedButtonIndexes.has(index));
      });
    };

    gaps.forEach((gap, index) => {
      gap.addEventListener('focus', () => {
        activeGap = gap;
      });

      gap.addEventListener('input', () => {
        gap.classList.remove('is-correct', 'is-wrong');
        const item = gap.closest('[data-superlative-item]');
        item?.removeAttribute('data-checked');
        const feedback = item?.querySelector('[data-superlative-feedback]');
        if (feedback) feedback.textContent = '';
        updateWordUsage();
        updateScore();
        updateRevealVisibility();
      });

      gap.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          const item = gap.closest<HTMLElement>('[data-superlative-item]');
          item?.querySelector<HTMLButtonElement>('[data-check-superlative-item]')?.click();
          gaps[index + 1]?.focus();
        }
      });
    });

    wordButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (!(activeGap instanceof HTMLInputElement)) return;
        activeGap.value = button.dataset.superlativeWord ?? '';
        activeGap.dispatchEvent(new Event('input', { bubbles: true }));
        const nextGap = gaps[gaps.indexOf(activeGap) + 1];
        if (nextGap instanceof HTMLInputElement) nextGap.focus();
      });
    });

    exercise.querySelectorAll<HTMLButtonElement>('[data-check-superlative-item]').forEach((button) => {
      button.addEventListener('click', () => {
        const item = button.closest<HTMLElement>('[data-superlative-item]');
        if (!item) return;

        const itemGaps = Array.from(item.querySelectorAll<HTMLInputElement>('.superlative-gap'));
        const feedback = item.querySelector('[data-superlative-feedback]');

        if (!itemIsComplete(item)) {
          if (feedback) feedback.textContent = 'Complète d’abord la phrase.';
          return;
        }

        const isCorrectItem = itemGaps.every((gap) => acceptedAnswers(gap).includes(normalize(gap.value)));
        itemGaps.forEach((gap) => {
          const isCorrect = acceptedAnswers(gap).includes(normalize(gap.value));
          gap.classList.toggle('is-correct', isCorrect);
          gap.classList.toggle('is-wrong', !isCorrect);
        });

        item.setAttribute('data-checked', 'true');
        if (feedback) feedback.textContent = isCorrectItem ? 'Correct.' : 'À corriger.';
        updateWordUsage();
        updateScore();
        updateRevealVisibility();
      });
    });

    revealButton?.addEventListener('click', () => {
      gaps.forEach((gap) => {
        gap.value = primaryAnswer(gap);
        gap.classList.add('is-correct');
        gap.classList.remove('is-wrong');
      });
      exercise.querySelectorAll<HTMLElement>('[data-superlative-item]').forEach((item) => {
        item.setAttribute('data-checked', 'true');
        const feedback = item.querySelector('[data-superlative-feedback]');
        if (feedback) feedback.textContent = 'Réponse affichée.';
      });
      updateWordUsage();
      updateScore();
      updateRevealVisibility();
    });

    exercise.querySelector('[data-reset-superlative]')?.addEventListener('click', () => {
      gaps.forEach((gap) => {
        gap.value = '';
        gap.classList.remove('is-correct', 'is-wrong');
      });
      exercise.querySelectorAll<HTMLElement>('[data-superlative-item]').forEach((item) => {
        item.removeAttribute('data-checked');
        const feedback = item.querySelector('[data-superlative-feedback]');
        if (feedback) feedback.textContent = '';
      });
      updateWordUsage();
      updateScore();
      updateRevealVisibility();
      gaps[0]?.focus();
    });

    updateWordUsage();
    updateScore();
    updateRevealVisibility();
  });
</script>

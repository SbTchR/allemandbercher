---
type Props = {
  sourceUrl?: string;
};

const { sourceUrl } = Astro.props;
---

<details class="conjugation-reference">
  <summary>
    <span>
      <strong>Tableaux complets et ressources</strong>
      <small>Retrouve ici les tableaux détaillés et des ressources supplémentaires.</small>
    </span>
    <span class="conjugation-reference__action" aria-hidden="true">Ouvrir</span>
  </summary>

  <div class="conjugation-reference__body">
    <slot />
    {
      sourceUrl && (
        <p class="conjugation-reference__source">
          <a href={sourceUrl} rel="noreferrer" target="_blank">Consulter aussi la page originale</a>
        </p>
      )
    }
  </div>
</details>

<style>
  .conjugation-reference {
    margin-top: 24px;
    overflow: clip;
    border: 1px solid #d9e0ee;
    border-radius: 16px;
    background: #fff;
  }

  .conjugation-reference > summary {
    display: flex;
    min-height: 70px;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 15px 18px;
    cursor: pointer;
    list-style: none;
  }

  .conjugation-reference > summary::-webkit-details-marker {
    display: none;
  }

  .conjugation-reference > summary span:first-child {
    display: grid;
    gap: 3px;
  }

  .conjugation-reference > summary strong {
    color: #172a58;
    font-size: 1rem;
  }

  .conjugation-reference > summary small {
    color: #5d6981;
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .conjugation-reference__action {
    flex: 0 0 auto;
    padding: 7px 11px;
    border-radius: 999px;
    background: #edf3ff;
    color: #294c91;
    font-size: 0.76rem;
    font-weight: 850;
  }

  .conjugation-reference[open] .conjugation-reference__action::before {
    content: "Refermer";
  }

  .conjugation-reference[open] .conjugation-reference__action {
    font-size: 0;
  }

  .conjugation-reference[open] .conjugation-reference__action::before {
    font-size: 0.76rem;
  }

  .conjugation-reference__body {
    padding: 20px clamp(16px, 3vw, 28px) 24px;
    border-top: 1px solid #e3e8f2;
    background: #fbfcff;
  }

  .conjugation-reference__source {
    margin: 24px 0 0;
    padding-top: 16px;
    border-top: 1px dashed #ccd5e6;
  }

  .conjugation-reference__source a {
    color: #294c91;
    font-weight: 800;
  }

  @media (max-width: 560px) {
    .conjugation-reference > summary {
      align-items: flex-start;
      padding: 14px;
    }

    .conjugation-reference > summary small {
      display: none;
    }
  }
</style>

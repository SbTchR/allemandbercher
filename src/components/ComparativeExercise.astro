---
const items = [
  {
    prompt: 'Dehors, il fait plus froid que dans la maison.',
    parts: ['Draussen ist es ', ' ', ' im Haus.'],
    gaps: [
      { answer: 'kälter', aliases: ['kaelter'] },
      { answer: 'als', aliases: [] },
    ],
  },
  {
    prompt: 'Ma grand-mère est plus vieille que ma tante.',
    parts: ['Meine Grossmutter ist ', ' ', ' meine Tante.'],
    gaps: [
      { answer: 'älter', aliases: ['aelter'] },
      { answer: 'als', aliases: [] },
    ],
  },
  {
    prompt: "Nos vacances sont aussi courtes que l'année dernière.",
    parts: ['Unsere Herbstferien sind ', ' ', ' ', ' im letzten Jahr.'],
    gaps: [
      { answer: 'genauso', aliases: [] },
      { answer: 'kurz', aliases: [] },
      { answer: 'wie', aliases: [] },
    ],
  },
  {
    prompt: 'Alex est meilleur que Markus en mathématique.',
    parts: ['Alex ist ', ' ', ' Markus in Mathematik.'],
    gaps: [
      { answer: 'besser', aliases: [] },
      { answer: 'als', aliases: [] },
    ],
  },
  {
    prompt: 'Je préfère le thé au café.',
    parts: ['Ich mag ', ' Tee ', ' Kaffee.'],
    gaps: [
      { answer: 'lieber', aliases: [] },
      { answer: 'als', aliases: [] },
    ],
  },
];

const wordBank = items.flatMap((item) => item.gaps.map((gap) => gap.answer));
const gapCount = items.reduce((count, item) => count + item.gaps.length, 0);
---

<section class="content-band comparative-exercise" aria-labelledby="comparative-exercise-title" data-comparative-exercise>
  <div class="comparative-exercise-header">
    <div>
      <p class="home-section-label">Exercice intégré</p>
      <h2 id="comparative-exercise-title">Komparativ</h2>
      <p>Complète les phrases en allemand avec la forme correcte du comparatif.</p>
    </div>
    <output class="comparative-score" data-comparative-score aria-live="polite">0 / {gapCount}</output>
  </div>

  <div class="comparative-workspace">
    <div class="comparative-items">
      {
        items.map((item, itemIndex) => (
          <article class="comparative-item">
            <p class="comparative-prompt">
              <strong>{itemIndex + 1}.</strong> {item.prompt}
            </p>
            <p class="comparative-sentence">
              {item.parts.map((part, partIndex) => (
                <>
                  {part}
                  {item.gaps[partIndex] && (
                    <input
                      class="comparative-gap"
                      type="text"
                      inputmode="text"
                      autocomplete="off"
                      autocapitalize="off"
                      spellcheck="false"
                      aria-label={`Réponse ${itemIndex + 1}.${partIndex + 1}`}
                      data-answer={[item.gaps[partIndex].answer, ...item.gaps[partIndex].aliases].join('|')}
                    />
                  )}
                </>
              ))}
            </p>
            <div class="comparative-item-footer">
              <p class="comparative-feedback" data-comparative-feedback aria-live="polite"></p>
              <button class="text-link comparative-item-reveal" type="button" data-show-item hidden>
                Afficher la réponse
              </button>
            </div>
          </article>
        ))
      }
    </div>

    <aside class="comparative-side" aria-label="Mots et actions">
      <div class="comparative-word-bank" aria-label="Mots disponibles">
        {wordBank.map((word) => <button type="button" data-word={word}>{word}</button>)}
      </div>

      <div class="comparative-actions">
        <button class="quest-launch-button comparative-check-button" type="button" data-check-comparative>Vérifier</button>
        <button class="text-link" type="button" data-reset-comparative>Recommencer</button>
      </div>
    </aside>
  </div>
</section>

<script>
  const exercise = document.querySelector('[data-comparative-exercise]');

  if (exercise instanceof HTMLElement) {
    const gaps = Array.from(exercise.querySelectorAll<HTMLInputElement>('.comparative-gap'));
    const wordButtons = Array.from(exercise.querySelectorAll<HTMLButtonElement>('[data-word]'));
    const score = exercise.querySelector('[data-comparative-score]');
    let activeGap = gaps[0];

    const normalize = (value: string) =>
      value
        .trim()
        .toLowerCase()
        .normalize('NFC')
        .replace(/\s+/g, ' ');

    const acceptedAnswers = (input: HTMLInputElement) => String(input.dataset.answer ?? '').split('|').map(normalize);
    const primaryAnswer = (input: HTMLInputElement) => String(input.dataset.answer ?? '').split('|')[0] ?? '';

    const updateScore = () => {
      const correct = gaps.filter((gap) => gap.classList.contains('is-correct')).length;
      if (score) score.textContent = `${correct} / ${gaps.length}`;
    };

    const itemIsComplete = (item: Element) => {
      const itemGaps = Array.from(item.querySelectorAll<HTMLInputElement>('.comparative-gap'));
      return itemGaps.every((gap) => normalize(gap.value) !== '');
    };

    const updateRevealButtons = () => {
      exercise.querySelectorAll('.comparative-item').forEach((item) => {
        const revealButton = item.querySelector<HTMLButtonElement>('[data-show-item]');
        if (revealButton) {
          const hasBeenChecked = item.getAttribute('data-checked') === 'true';
          revealButton.hidden = !(hasBeenChecked && itemIsComplete(item));
        }
      });
    };

    const updateWordUsage = () => {
      const usedButtonIndexes = new Set<number>();
      const filledValues = gaps.map((gap) => normalize(gap.value)).filter(Boolean);

      filledValues.forEach((value) => {
        const buttonIndex = wordButtons.findIndex((button, index) => {
          return !usedButtonIndexes.has(index) && normalize(button.dataset.word ?? '') === value;
        });

        if (buttonIndex >= 0) {
          usedButtonIndexes.add(buttonIndex);
        }
      });

      wordButtons.forEach((button, index) => {
        button.classList.toggle('is-used', usedButtonIndexes.has(index));
      });
    };

    gaps.forEach((gap, index) => {
      gap.addEventListener('focus', () => {
        activeGap = gap;
      });

      gap.addEventListener('input', () => {
        gap.classList.remove('is-correct', 'is-wrong');
        const item = gap.closest('.comparative-item');
        item?.removeAttribute('data-checked');
        const feedback = item?.querySelector('[data-comparative-feedback]');
        if (feedback) feedback.textContent = '';
        updateRevealButtons();
        updateWordUsage();
        updateScore();
      });

      gap.addEventListener('keydown', (event) => {
        const keyboardEvent = event as KeyboardEvent;

        if (keyboardEvent.key === 'Enter') {
          event.preventDefault();
          gaps[index + 1]?.focus();
        }
      });
    });

    exercise.querySelectorAll('[data-word]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!(activeGap instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement)) return;
        activeGap.value = button.dataset.word ?? '';
        activeGap.dispatchEvent(new Event('input', { bubbles: true }));
        const nextGap = gaps[gaps.indexOf(activeGap) + 1];
        if (nextGap instanceof HTMLInputElement) nextGap.focus();
      });
    });

    exercise.querySelector('[data-check-comparative]')?.addEventListener('click', () => {
      exercise.querySelectorAll('.comparative-item').forEach((item) => {
        const itemGaps = Array.from(item.querySelectorAll<HTMLInputElement>('.comparative-gap'));
        const feedback = item.querySelector('[data-comparative-feedback]');
        let itemIsCorrect = true;

        if (itemIsComplete(item)) {
          item.setAttribute('data-checked', 'true');
        } else {
          item.removeAttribute('data-checked');
        }

        itemGaps.forEach((gap) => {
          const isCorrect = acceptedAnswers(gap).includes(normalize(gap.value));
          gap.classList.toggle('is-correct', isCorrect);
          gap.classList.toggle('is-wrong', !isCorrect);
          if (!isCorrect) itemIsCorrect = false;
        });

        if (feedback) feedback.textContent = itemIsCorrect ? 'Correct.' : 'À corriger.';
      });

      updateRevealButtons();
      updateWordUsage();
      updateScore();
    });

    exercise.querySelector('[data-reset-comparative]')?.addEventListener('click', () => {
      gaps.forEach((gap) => {
        gap.value = '';
        gap.classList.remove('is-correct', 'is-wrong');
      });
      exercise.querySelectorAll('[data-comparative-feedback]').forEach((feedback) => {
        feedback.textContent = '';
      });
      exercise.querySelectorAll<HTMLButtonElement>('[data-show-item]').forEach((button) => {
        button.hidden = true;
      });
      exercise.querySelectorAll('.comparative-item').forEach((item) => {
        item.removeAttribute('data-checked');
      });
      updateWordUsage();
      gaps[0]?.focus();
      updateScore();
    });

    exercise.querySelectorAll('[data-show-item]').forEach((button) => {
      button.addEventListener('click', () => {
        const item = button.closest('.comparative-item');
        if (!item) return;

        const itemGaps = Array.from(item.querySelectorAll<HTMLInputElement>('.comparative-gap'));
        itemGaps.forEach((gap) => {
          gap.value = primaryAnswer(gap);
          gap.classList.add('is-correct');
          gap.classList.remove('is-wrong');
        });

        const feedback = item.querySelector('[data-comparative-feedback]');
        if (feedback) feedback.textContent = 'Réponse affichée.';
        updateRevealButtons();
        updateWordUsage();
        updateScore();
      });
    });

    updateRevealButtons();
    updateWordUsage();
  }
</script>

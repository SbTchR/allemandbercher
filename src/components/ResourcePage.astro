---
import { render } from 'astro:content';
import ComparativeExercise from './ComparativeExercise.astro';
import ComparativeRuleLab from './ComparativeRuleLab.astro';
import ComparativeTheoryContent from './ComparativeTheoryContent.astro';
import CasesPracticeSuite from './CasesPracticeSuite.astro';
import ConjugationAdvancedTheory from './ConjugationAdvancedTheory.astro';
import ConjugationCoreTheory from './ConjugationCoreTheory.astro';
import ConjugationSourceReference from './ConjugationSourceReference.astro';
import ExternalLinks from './ExternalLinks.astro';
import GrammarTheoryContent from './GrammarTheoryContent.astro';
import ImageGallery from './ImageGallery.astro';
import Layout from './Layout.astro';
import ModalSentencePracticeSuite from './ModalSentencePracticeSuite.astro';
import ModalSentenceTheoryContent from './ModalSentenceTheoryContent.astro';
import ObjectiveBox from './ObjectiveBox.astro';
import PerfectSentencePracticeSuite from './PerfectSentencePracticeSuite.astro';
import PerfectSentenceTheoryContent from './PerfectSentenceTheoryContent.astro';
import SuperlativePracticeSuite from './SuperlativePracticeSuite.astro';
import SuperlativeRuleLab from './SuperlativeRuleLab.astro';
import SuperlativeTheoryContent from './SuperlativeTheoryContent.astro';
import SyntaxQuestionsLesson from './SyntaxQuestionsLesson.astro';
import SyntaxVerbPositionLesson from './SyntaxVerbPositionLesson.astro';
import TheoryBox from './TheoryBox.astro';
import TheoryObservation from './TheoryObservation.astro';
import AdviceJourney from './AdviceJourney.astro';
import LessonSupport from './LessonSupport.astro';
import ListeningPractice from './ListeningPractice.astro';
import TheoryPracticeSuite from './TheoryPracticeSuite.astro';
import VerbPositionPracticeSuite from './VerbPositionPracticeSuite.astro';
import WritingExerciseLab from './WritingExerciseLab.astro';
import { grammarTheoryPageSlugs, type GrammarTheoryPageSlug } from '../data/grammarTheory';
import { lessonResources } from '../data/lessonResources';
import { withBase } from '../lib/paths';
import { resourceEyebrow, type ResourceEntry } from '../lib/resources';

type Props = {
  entry: ResourceEntry;
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const isLearningPage = entry.collection === 'theorie' || entry.collection === 'conseils';
const hasObjectives = entry.data.objectives.length > 0;
const hasAside = entry.data.externalLinks.length > 0;
const primaryAction = entry.data.primaryAction;
const slug = entry.id.split('/').pop()?.replace(/\.md$/, '');
const hasComparativeExercise = entry.collection === 'theorie' && entry.data.category === 'grammaire' && slug === 'le-comparatif';
const hasSuperlativeExercise = entry.collection === 'theorie' && entry.data.category === 'grammaire' && slug === 'le-superlatif';
const hasVerbPositionExercise =
  entry.collection === 'theorie' && entry.data.category === 'syntaxe' && slug === 'la-place-du-verbe-principal';
const hasQuestionsLesson =
  entry.collection === 'theorie' && entry.data.category === 'syntaxe' && slug === 'les-questions';
const hasModalSentenceLesson =
  entry.collection === 'theorie' &&
  entry.data.category === 'syntaxe' &&
  slug === 'les-phrases-avec-verbe-de-modalite';
const hasPerfectSentenceLesson =
  entry.collection === 'theorie' &&
  entry.data.category === 'syntaxe' &&
  slug === 'les-phrases-au-passe-compose';
const customGrammarSlug =
  entry.collection === 'theorie' &&
  entry.data.category === 'grammaire' &&
  slug &&
  grammarTheoryPageSlugs.includes(slug as GrammarTheoryPageSlug)
    ? (slug as GrammarTheoryPageSlug)
    : undefined;
const coreConjugationSlugs = ['present', 'imperatif', 'futur', 'les-verbes-reflexifs'] as const;
type CoreConjugationSlug = (typeof coreConjugationSlugs)[number];
const customCoreConjugationSlug =
  entry.collection === 'theorie' &&
  entry.data.category === 'conjugaison' &&
  slug &&
  coreConjugationSlugs.includes(slug as CoreConjugationSlug)
    ? (slug as CoreConjugationSlug)
    : undefined;
const advancedConjugationSlugs = ['passe-compose', 'preterit', 'verbes-de-modalite', 'konjunktiv-ii'] as const;
type AdvancedConjugationSlug = (typeof advancedConjugationSlugs)[number];
const customAdvancedConjugationSlug =
  entry.collection === 'theorie' &&
  entry.data.category === 'conjugaison' &&
  slug &&
  advancedConjugationSlugs.includes(slug as AdvancedConjugationSlug)
    ? (slug as AdvancedConjugationSlug)
    : undefined;
const hasWritingExerciseLab = entry.collection === 'conseils' && slug === 'expression-ecrite';
const extraResources = entry.collection === 'theorie' ? lessonResources[`${entry.data.category}/${slug}`] ?? [] : [];
const hasHeaderCallout = hasObjectives;
const hasDedicatedTheoryPractice =
  hasComparativeExercise ||
  hasSuperlativeExercise ||
  hasVerbPositionExercise ||
  hasModalSentenceLesson ||
  hasPerfectSentenceLesson ||
  customGrammarSlug === 'les-cas-theorie-de-base';
const theoryCategoryLabels = {
  grammaire: 'Grammaire',
  syntaxe: 'Syntaxe',
  conjugaison: 'Conjugaison',
  general: 'Théorie générale',
};
const isExerciseChapter = entry.collection === 'exercices' && entry.data.pageType === 'chapitre';
const hasChapterDashboard =
  isExerciseChapter &&
  (entry.data.communicationObjectives.length > 0 || entry.data.languageFocus.length > 0 || Boolean(entry.data.finalMission));

---

<Layout title={entry.data.title} description={entry.data.description}>
  <article class:list={["resource-page", { "learning-page": isLearningPage }]}>
    {
      entry.collection === 'theorie' && (
        <nav class="breadcrumb" aria-label="Fil d’Ariane">
          <a href={withBase('/theorie/')}>Théorie</a>
          <span aria-hidden="true">›</span>
          <a href={withBase(`/theorie/${entry.data.category}/`)}>{theoryCategoryLabels[entry.data.category]}</a>
          <span aria-hidden="true">›</span>
          <span aria-current="page">{entry.data.title}</span>
        </nav>
      )
    }

    <header class:list={['resource-header', { 'resource-header-with-callout': hasHeaderCallout }]}>
      <div class="resource-title-block">
        <p class="eyebrow">{resourceEyebrow(entry)}</p>
        <h1>{entry.data.title}</h1>
        {
          primaryAction ? (
            <button class="quest-launch-button" type="button" data-open-resource-modal>
              {primaryAction.label}
            </button>
          ) : (
            entry.data.description && <p class="lead">{entry.data.description}</p>
          )
        }
      </div>

      {hasObjectives && <ObjectiveBox title={isExerciseChapter ? 'Objectifs du chapitre' : 'Objectifs'} objectives={entry.data.objectives} />}
    </header>

    {
      hasChapterDashboard && (
        <section class="chapter-dashboard" aria-label="Repères du chapitre">
          <article>
            <strong>Communication</strong>
            {
              entry.data.communicationObjectives.length > 0 ? (
                <ul>
                  {entry.data.communicationObjectives.map((objective) => (
                    <li>{objective}</li>
                  ))}
                </ul>
              ) : (
                <p>À compléter avec la méthode.</p>
              )
            }
          </article>
          <article>
            <strong>Langue</strong>
            {
              entry.data.languageFocus.length > 0 ? (
                <ul>
                  {entry.data.languageFocus.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              ) : (
                <p>À compléter avec la méthode.</p>
              )
            }
          </article>
          <article>
            <strong>Mission finale</strong>
            <p>{entry.data.finalMission || 'À compléter avec la méthode.'}</p>
          </article>
        </section>
      )
    }

    {isLearningPage && <LessonSupport />}
    <div id={isLearningPage ? 'lesson' : undefined} class:list={['resource-layout', { 'resource-layout-wide': !hasAside }]}>
      <div class="prose">
        {
          entry.collection === 'theorie' ? (
            <TheoryBox category={entry.data.category}>
              {
                hasComparativeExercise ? (
                  <ComparativeTheoryContent />
                ) : hasSuperlativeExercise ? (
                  <SuperlativeTheoryContent />
                ) : hasVerbPositionExercise ? (
                  <SyntaxVerbPositionLesson />
                ) : hasQuestionsLesson ? (
                  <SyntaxQuestionsLesson />
                ) : hasModalSentenceLesson ? (
                  <ModalSentenceTheoryContent />
                ) : hasPerfectSentenceLesson ? (
                  <PerfectSentenceTheoryContent />
                ) : customCoreConjugationSlug ? (
                  <>
                    <ConjugationCoreTheory slug={customCoreConjugationSlug} />
                    <ConjugationSourceReference sourceUrl={entry.data.sourceUrl}>
                      <Content />
                    </ConjugationSourceReference>
                  </>
                ) : customAdvancedConjugationSlug ? (
                  <>
                    <ConjugationAdvancedTheory slug={customAdvancedConjugationSlug} />
                    <ConjugationSourceReference sourceUrl={entry.data.sourceUrl}>
                      <Content />
                    </ConjugationSourceReference>
                  </>
                ) : customGrammarSlug ? (
                  <>
                    <TheoryObservation category={entry.data.category} slug={customGrammarSlug} />
                    <GrammarTheoryContent slug={customGrammarSlug} />
                  </>
                ) : (
                  <>
                    {slug && <TheoryObservation category={entry.data.category} slug={slug} />}
                    <Content />
                  </>
                )
              }
            </TheoryBox>
          ) : entry.collection === 'conseils' ? (
            <AdviceJourney><Content /></AdviceJourney>
          ) : (
            <Content />
          )
        }
      </div>

      {
        hasAside && (
          <aside class="resource-aside">
            <ExternalLinks links={entry.data.externalLinks} />
          </aside>
        )
      }
    </div>

    <div id={isLearningPage ? "practice" : undefined}>
    {hasComparativeExercise && <ComparativeRuleLab />}
    {hasComparativeExercise && <ComparativeExercise />}
    {hasSuperlativeExercise && <SuperlativeRuleLab />}
    {hasSuperlativeExercise && <SuperlativePracticeSuite />}
    {hasVerbPositionExercise && <VerbPositionPracticeSuite />}
    {hasModalSentenceLesson && <ModalSentencePracticeSuite />}
    {hasPerfectSentenceLesson && <PerfectSentencePracticeSuite />}
    {customGrammarSlug === 'les-cas-theorie-de-base' && <CasesPracticeSuite />}
    {hasWritingExerciseLab && <WritingExerciseLab />}
    {
      entry.collection === 'theorie' && slug && !hasDedicatedTheoryPractice && (
        <TheoryPracticeSuite category={entry.data.category} slug={slug} />
      )
    }

    {entry.collection === 'conseils' && slug === 'comprehension-orale' && <ListeningPractice />}
    {entry.collection === 'conseils' && slug && <TheoryPracticeSuite category="conseils" slug={slug} />}
    </div>
    {extraResources.length > 0 && <section class="content-band">
      <h2>D’autres exercices pour continuer</h2>
      <div class="external-button-grid">{extraResources.map(link => <a href={link.url} target="_blank" rel="noreferrer">{link.label}</a>)}</div>
    </section>}
    <ImageGallery images={customGrammarSlug ? [] : entry.data.images} />

    {
      primaryAction && (
        <dialog class="resource-modal" data-resource-modal>
          <div class="resource-modal-panel">
            <div class="resource-modal-header">
              <h2>{primaryAction.title}</h2>
              <button class="resource-modal-close" type="button" data-close-resource-modal>
                Fermer
              </button>
            </div>
            <iframe src={withBase(primaryAction.src)} title={primaryAction.title} loading="lazy"></iframe>
          </div>
        </dialog>
      )
    }
  </article>

  {
    primaryAction && (
      <script>
        const modal = document.querySelector('[data-resource-modal]');
        const openButton = document.querySelector('[data-open-resource-modal]');
        const closeButton = document.querySelector('[data-close-resource-modal]');

        openButton?.addEventListener('click', () => {
          if (modal instanceof HTMLDialogElement) {
            modal.showModal();
          }
        });

        closeButton?.addEventListener('click', () => {
          if (modal instanceof HTMLDialogElement) {
            modal.close();
          }
        });

        modal?.addEventListener('click', (event) => {
          if (event.target === modal && modal instanceof HTMLDialogElement) {
            modal.close();
          }
        });
      </script>
    )
  }

</Layout>

<script>
  const initialiseConjugationCore = (root: HTMLElement) => {
    if (root.dataset.coreReady === 'true') return;
    root.dataset.coreReady = 'true';

    root.querySelectorAll<HTMLElement>('[data-core-lab]').forEach((lab) => {
      const buttons = [...lab.querySelectorAll<HTMLButtonElement>('[data-core-choice]')];

      const activate = (button: HTMLButtonElement) => {
        buttons.forEach((candidate) => {
          candidate.setAttribute('aria-pressed', candidate === button ? 'true' : 'false');
        });

        lab.querySelectorAll<HTMLElement>('[data-core-output]').forEach((output) => {
          const key = output.dataset.coreOutput;
          if (!key) return;
          const value = button.getAttribute(`data-${key}`) ?? '';
          output.textContent = value;
          if (output.hasAttribute('data-hide-when-empty')) {
            output.hidden = value.length === 0;
          }
        });

        const reflexive = lab.querySelector<HTMLElement>('[data-core-output="reflexive"]');
        const grammaticalCase = button.dataset.case;
        if (reflexive && grammaticalCase) {
          reflexive.classList.toggle('case-chip-accusative', grammaticalCase === 'accusative');
          reflexive.classList.toggle('case-chip-dative', grammaticalCase === 'dative');
        }
      };

      buttons.forEach((button) => button.addEventListener('click', () => activate(button)));
      const initial = buttons.find((button) => button.getAttribute('aria-pressed') === 'true') ?? buttons[0];
      if (initial) activate(initial);
    });
  };

  document.querySelectorAll<HTMLElement>('[data-conjugation-core]').forEach(initialiseConjugationCore);
</script>


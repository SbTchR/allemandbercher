---
type ConjugationCoreSlug = 'present' | 'imperatif' | 'futur' | 'les-verbes-reflexifs';

interface Props {
  slug: ConjugationCoreSlug;
}

const { slug } = Astro.props;

const presentRows = [
  { label: 'ich', subject: 'ich', radical: 'mach', ending: 'e', form: 'mache', note: 'Avec ich, la terminaison est -e.' },
  { label: 'du', subject: 'du', radical: 'mach', ending: 'st', form: 'machst', note: 'Avec du, la terminaison régulière est -st.' },
  {
    label: 'er / sie / es',
    subject: 'er / sie / es',
    radical: 'mach',
    ending: 't',
    form: 'macht',
    note: 'Avec er, sie ou es, la terminaison est -t.',
  },
  {
    label: 'wir',
    subject: 'wir',
    radical: 'mach',
    ending: 'en',
    form: 'machen',
    note: 'Avec wir, la forme est identique à l’infinitif.',
  },
  { label: 'ihr', subject: 'ihr', radical: 'mach', ending: 't', form: 'macht', note: 'Avec ihr, la terminaison est -t.' },
  {
    label: 'sie / Sie',
    subject: 'sie / Sie',
    radical: 'mach',
    ending: 'en',
    form: 'machen',
    note: 'Avec sie au pluriel ou Sie de politesse, la terminaison est -en.',
  },
] as const;

const irregularPresentRows = [
  { person: 'ich', sein: 'bin', haben: 'habe', fahren: 'fahre', essen: 'esse' },
  { person: 'du', sein: 'bist', haben: 'hast', fahren: 'fährst', essen: 'isst' },
  { person: 'er / sie / es', sein: 'ist', haben: 'hat', fahren: 'fährt', essen: 'isst' },
  { person: 'wir', sein: 'sind', haben: 'haben', fahren: 'fahren', essen: 'essen' },
  { person: 'ihr', sein: 'seid', haben: 'habt', fahren: 'fahrt', essen: 'esst' },
  { person: 'sie / Sie', sein: 'sind', haben: 'haben', fahren: 'fahren', essen: 'essen' },
] as const;

const imperativeRows = [
  { audience: 'du', construction: 'radical + parfois -e', example: 'Geh!', sein: 'Sei!' },
  { audience: 'ihr', construction: 'forme du présent sans ihr', example: 'Geht!', sein: 'Seid!' },
  { audience: 'Sie', construction: 'infinitif + Sie', example: 'Gehen Sie!', sein: 'Seien Sie!' },
  { audience: 'wir', construction: 'infinitif + wir', example: 'Gehen wir!', sein: 'Seien wir ehrlich!' },
] as const;

const futureRows = [
  { person: 'ich', form: 'werde' },
  { person: 'du', form: 'wirst' },
  { person: 'er / sie / es', form: 'wird' },
  { person: 'wir', form: 'werden' },
  { person: 'ihr', form: 'werdet' },
  { person: 'sie / Sie', form: 'werden' },
] as const;

const futureLabRows = [
  { label: 'ich', subject: 'Ich', form: 'werde', tail: 'nach Berlin reisen.', note: 'werden prend la forme werde avec ich.' },
  { label: 'du', subject: 'Du', form: 'wirst', tail: 'viel Deutsch sprechen.', note: 'La forme avec du est wirst.' },
  { label: 'er / sie / es', subject: 'Mia', form: 'wird', tail: 'später im Ausland arbeiten.', note: 'Avec une personne au singulier, on emploie wird.' },
  { label: 'wir', subject: 'Wir', form: 'werden', tail: 'nächstes Jahr reisen.', note: 'Avec wir, werden garde la forme de l’infinitif.' },
  { label: 'ihr', subject: 'Ihr', form: 'werdet', tail: 'bald mehr verstehen.', note: 'Avec ihr, la forme est werdet.' },
  { label: 'sie / Sie', subject: 'Sie', form: 'werden', tail: 'morgen anfangen.', note: 'sie au pluriel et Sie de politesse prennent werden.' },
] as const;

const reflexiveRows = [
  { person: 'ich', accusative: 'mich', dative: 'mir' },
  { person: 'du', accusative: 'dich', dative: 'dir' },
  { person: 'er / sie / es', accusative: 'sich', dative: 'sich' },
  { person: 'wir', accusative: 'uns', dative: 'uns' },
  { person: 'ihr', accusative: 'euch', dative: 'euch' },
  { person: 'sie', accusative: 'sich', dative: 'sich' },
  { person: 'Sie', accusative: 'sich', dative: 'sich' },
] as const;
---

<section class:list={['conjugation-core', `core-page-${slug}`]} data-conjugation-core={slug}>
  {
    slug === 'present' && (
      <>
        <section class="core-rule" aria-labelledby="present-rule-title">
          <div>
            <p class="core-section-label">À retenir</p>
            <h2 id="present-rule-title">Le sujet choisit la terminaison</h2>
            <p>Le présent décrit ce qui se passe maintenant, une habitude ou un fait général.</p>
          </div>
          <div class="core-formula" aria-label="Formule du présent">
            <span class="core-radical">radical</span>
            <span aria-hidden="true">+</span>
            <span class="core-ending">terminaison personnelle</span>
            <span aria-hidden="true">=</span>
            <span class="mark-verb">verbe conjugué</span>
          </div>
        </section>

        <div class="core-legend" aria-label="Légende des couleurs grammaticales">
          <span><span class="mark-subject">sujet</span> jaune</span>
          <span><span class="mark-verb">verbe conjugué</span> rouge</span>
          <span><span class="core-radical">radical</span> violet</span>
          <span><span class="core-ending">terminaison</span> orange</span>
        </div>

        <section class="core-lab" data-core-lab aria-labelledby="present-lab-title">
          <div>
            <p class="core-section-label">Atelier</p>
            <h2 id="present-lab-title">Choisis un sujet</h2>
            <div class="core-choice-list core-choice-grid" role="group" aria-label="Choisir un pronom personnel">
              {
                presentRows.map((row, index) => (
                  <button
                    type="button"
                    data-core-choice
                    data-subject={row.subject}
                    data-radical={row.radical}
                    data-ending={row.ending}
                    data-form={row.form}
                    data-note={row.note}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                  >
                    {row.label}
                  </button>
                ))
              }
            </div>
          </div>
          <div class="core-stage" data-core-example aria-live="polite">
            <p class="core-stage-kicker">Construis la forme</p>
            <p class="core-stage-sentence">
              <span class="mark-subject" data-core-output="subject">ich</span>
              <span aria-hidden="true"> + </span>
              <span class="core-word-build">
                <span class="core-radical" data-core-output="radical">mach</span><span class="core-ending" data-core-output="ending">e</span>
              </span>
              <span aria-hidden="true"> = </span>
              <span class="mark-verb" data-core-output="form">mache</span>
            </p>
            <p class="core-stage-note" data-core-output="note">Avec ich, la terminaison est -e.</p>
          </div>
        </section>

        <section class="core-card" aria-labelledby="present-table-title">
          <div class="core-heading-row">
            <div>
              <p class="core-section-label">Modèle régulier</p>
              <h2 id="present-table-title"><span lang="de">machen</span> — faire</h2>
            </div>
            <p>Le radical <strong class="core-radical">mach-</strong> ne change pas.</p>
          </div>
          <div class="core-table-scroll" role="region" aria-label="Conjugaison de machen au présent" tabindex="0">
            <table class="core-table">
              <caption>Terminaisons régulières du présent</caption>
              <thead>
                <tr>
                  <th scope="col">Sujet</th>
                  <th scope="col">Radical</th>
                  <th scope="col">Terminaison</th>
                  <th scope="col">Forme</th>
                </tr>
              </thead>
              <tbody>
                {
                  presentRows.map((row) => (
                    <tr>
                      <th scope="row"><span class="mark-subject">{row.label}</span></th>
                      <td><span class="core-radical">{row.radical}-</span></td>
                      <td><span class="core-ending">-{row.ending}</span></td>
                      <td><strong class="mark-verb" lang="de">{row.form}</strong></td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        <section aria-labelledby="present-contrasts-title">
          <div class="core-heading-row">
            <div>
              <p class="core-section-label">Trois pièges utiles</p>
              <h2 id="present-contrasts-title">Le radical ne reste pas toujours identique</h2>
            </div>
          </div>
          <div class="core-contrast-grid">
            <article class="core-contrast-card">
              <strong>Un <span class="core-ending">e</span> aide à prononcer</strong>
              <p lang="de">arbeiten → du arbeit<span class="core-ending">est</span></p>
              <small>Après certains radicaux en -d, -t, -m ou -n.</small>
            </article>
            <article class="core-contrast-card">
              <strong>Pas de double son « s »</strong>
              <p lang="de">heissen → du heiss<span class="core-ending">t</span></p>
              <small>Avec un radical en -s, -ss, -x ou -z.</small>
            </article>
            <article class="core-contrast-card">
              <strong>La voyelle peut changer</strong>
              <p lang="de">du <span class="core-radical">fähr</span>st · er <span class="core-radical">iss</span>t</p>
              <small>Surtout avec du et er / sie / es.</small>
            </article>
          </div>
        </section>

        <section class="core-card" aria-labelledby="present-irregular-title">
          <div class="core-heading-row">
            <div>
              <p class="core-section-label">Formes essentielles</p>
              <h2 id="present-irregular-title">Quatre verbes à reconnaître vite</h2>
            </div>
            <p>Compare surtout les formes avec <span lang="de">du</span> et <span lang="de">er / sie / es</span>.</p>
          </div>
          <div class="core-table-scroll" role="region" aria-label="Verbes fréquents au présent" tabindex="0">
            <table class="core-table core-table-wide">
              <caption>Conjugaison de sein, haben, fahren et essen</caption>
              <thead>
                <tr>
                  <th scope="col">Sujet</th>
                  <th scope="col"><span lang="de">sein</span></th>
                  <th scope="col"><span lang="de">haben</span></th>
                  <th scope="col"><span lang="de">fahren</span></th>
                  <th scope="col"><span lang="de">essen</span></th>
                </tr>
              </thead>
              <tbody>
                {
                  irregularPresentRows.map((row) => (
                    <tr>
                      <th scope="row"><span class="mark-subject">{row.person}</span></th>
                      <td><strong class="mark-verb" lang="de">{row.sein}</strong></td>
                      <td><strong class="mark-verb" lang="de">{row.haben}</strong></td>
                      <td><strong class="mark-verb" lang="de">{row.fahren}</strong></td>
                      <td><strong class="mark-verb" lang="de">{row.essen}</strong></td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        <nav class="core-resource-strip" aria-label="Ressources complémentaires sur le présent">
          <strong>Pour aller plus loin</strong>
          <a href="https://quizlet.com/355592284" target="_blank" rel="noreferrer">103 verbes essentiels</a>
          <a href="https://www.schubert-verlag.de/aufgaben/xg/xg01_03.htm" target="_blank" rel="noreferrer">Exercice Schubert</a>
          <a href="https://deutsch.lingolia.com/de/grammatik/zeitformen/praesens/uebungen" target="_blank" rel="noreferrer">Exercice Lingolia</a>
        </nav>
      </>
    )
  }

  {
    slug === 'imperatif' && (
      <>
        <section class="core-rule" aria-labelledby="imperative-rule-title">
          <div>
            <p class="core-section-label">À retenir</p>
            <h2 id="imperative-rule-title">Le verbe ouvre la consigne</h2>
            <p>L’impératif sert à donner une consigne, faire une demande ou proposer une action.</p>
          </div>
          <div class="core-formula core-formula-stack" aria-label="Formule de la phrase impérative">
            <span><span class="mark-verb">verbe à l’impératif</span> en premier</span>
            <span class="core-formula-example" lang="de">
              <span class="mark-verb">Mach</span> bitte das Fenster <span class="mark-verbal-tail">zu</span>!
            </span>
          </div>
        </section>

        <div class="core-legend" aria-label="Légende des couleurs grammaticales">
          <span><span class="mark-subject">pronom exprimé</span> jaune</span>
          <span><span class="mark-verb">verbe conjugué</span> rouge</span>
          <span><span class="core-radical">radical</span> violet</span>
          <span><span class="mark-verbal-tail">particule séparable</span> violet</span>
        </div>

        <section class="core-lab" data-core-lab aria-labelledby="imperative-lab-title">
          <div>
            <p class="core-section-label">Atelier</p>
            <h2 id="imperative-lab-title">À qui parles-tu ?</h2>
            <div class="core-choice-list" role="group" aria-label="Choisir le destinataire de la consigne">
              <button
                type="button"
                data-core-choice
                data-verb="Geh"
                data-subject=""
                data-tail="geradeaus!"
                data-note="Avec du, le sujet disparaît : on part du radical."
                aria-pressed="true"
              >
                à une personne · du
              </button>
              <button
                type="button"
                data-core-choice
                data-verb="Geht"
                data-subject=""
                data-tail="geradeaus!"
                data-note="Avec ihr, on garde la forme du présent et on retire le pronom."
                aria-pressed="false"
              >
                à plusieurs · ihr
              </button>
              <button
                type="button"
                data-core-choice
                data-verb="Gehen"
                data-subject="Sie"
                data-tail="geradeaus!"
                data-note="À la forme de politesse, le verbe précède Sie."
                aria-pressed="false"
              >
                politesse · Sie
              </button>
              <button
                type="button"
                data-core-choice
                data-verb="Gehen"
                data-subject="wir"
                data-tail="ins Kino!"
                data-note="Avec wir, on propose une action commune : « Allons… »."
                aria-pressed="false"
              >
                proposition · wir
              </button>
            </div>
          </div>
          <div class="core-stage" data-core-example aria-live="polite">
            <p class="core-stage-kicker">La consigne change</p>
            <p class="core-stage-sentence" lang="de">
              <span class="mark-verb" data-core-output="verb">Geh</span>{' '}
              <span class="mark-subject" data-core-output="subject" data-hide-when-empty hidden></span>{' '}
              <span data-core-output="tail">geradeaus!</span>
            </p>
            <p class="core-stage-note" data-core-output="note">Avec du, le sujet disparaît : on part du radical.</p>
          </div>
        </section>

        <section class="core-card" aria-labelledby="imperative-table-title">
          <div class="core-heading-row">
            <div>
              <p class="core-section-label">Les quatre destinataires</p>
              <h2 id="imperative-table-title">Une construction par situation</h2>
            </div>
          </div>
          <div class="core-table-scroll" role="region" aria-label="Formes de l’impératif" tabindex="0">
            <table class="core-table">
              <caption>Formation de l’impératif avec gehen et sein</caption>
              <thead>
                <tr>
                  <th scope="col">Destinataire</th>
                  <th scope="col">Construction</th>
                  <th scope="col"><span lang="de">gehen</span></th>
                  <th scope="col"><span lang="de">sein</span></th>
                </tr>
              </thead>
              <tbody>
                {
                  imperativeRows.map((row) => (
                    <tr>
                      <th scope="row"><span class="mark-subject">{row.audience}</span></th>
                      <td>{row.construction}</td>
                      <td><strong class="mark-verb" lang="de">{row.example}</strong></td>
                      <td><strong class="mark-verb" lang="de">{row.sein}</strong></td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        <section aria-labelledby="imperative-contrasts-title">
          <div class="core-heading-row">
            <div>
              <p class="core-section-label">Les formes qui surprennent</p>
              <h2 id="imperative-contrasts-title">Observe le radical, pas seulement la forme avec du</h2>
            </div>
          </div>
          <div class="core-contrast-grid">
            <article class="core-contrast-card">
              <strong>e devient i ou ie</strong>
              <p lang="de">geben → <span class="mark-verb">Gib!</span> · lesen → <span class="mark-verb">Lies!</span></p>
              <small>Le changement reste et la forme est sans -e.</small>
            </article>
            <article class="core-contrast-card">
              <strong>L’Umlaut disparaît</strong>
              <p lang="de">fahren → <span class="mark-verb">Fahr!</span> · laufen → <span class="mark-verb">Lauf!</span></p>
              <small>On reprend la voyelle de l’infinitif.</small>
            </article>
            <article class="core-contrast-card">
              <strong>Le -e peut être nécessaire</strong>
              <p lang="de">arbeiten → <span class="mark-verb">Arbeite!</span> · rechnen → <span class="mark-verb">Rechne!</span></p>
              <small>Il rend certains groupes de consonnes prononçables.</small>
            </article>
          </div>
        </section>

        <section class="core-tip-strip" aria-label="Politesse et particules séparables">
          <article>
            <strong><span lang="de">bitte</span> rend la demande polie</strong>
            <p lang="de"><span class="mark-verb">Sprechen</span> Sie bitte langsam!</p>
          </article>
          <article>
            <strong><span lang="de">doch</span> encourage ou insiste doucement</strong>
            <p lang="de"><span class="mark-verb">Komm</span> doch mit!</p>
          </article>
          <article>
            <strong>La particule va à la fin</strong>
            <p lang="de"><span class="mark-verb">Pass</span> gut <span class="mark-verbal-tail">auf</span>!</p>
          </article>
        </section>

        <nav class="core-resource-strip" aria-label="Ressources complémentaires sur l’impératif">
          <strong>Pour aller plus loin</strong>
          <a href="https://mein-deutschbuch.de/grammatikuebungen-imperativ.html" target="_blank" rel="noreferrer">Mein Deutschbuch</a>
          <a href="https://deutsch.lingolia.com/de/grammatik/verben/imperativ/uebungen" target="_blank" rel="noreferrer">Lingolia</a>
          <a href="https://www.schubert-verlag.de/aufgaben/xg/xg06_12.htm" target="_blank" rel="noreferrer">Schubert-Verlag</a>
        </nav>
      </>
    )
  }

  {
    slug === 'futur' && (
      <>
        <section class="core-rule" aria-labelledby="future-rule-title">
          <div>
            <p class="core-section-label">Futur I</p>
            <h2 id="future-rule-title">Le verbe forme une pince</h2>
            <p>Dans une phrase affirmative, <span lang="de">werden</span> est conjugué et l’infinitif ferme la phrase.</p>
          </div>
          <div class="core-formula core-formula-stack" aria-label="Formule du futur I">
            <span><span class="mark-verb">werden conjugué</span> en position 2</span>
            <span><span class="mark-verbal-tail">infinitif</span> à la fin</span>
            <span class="core-formula-example" lang="de">
              Ich <span class="mark-verb">werde</span> nach Berlin <span class="mark-verbal-tail">reisen</span>.
            </span>
          </div>
        </section>

        <div class="core-legend" aria-label="Légende des couleurs grammaticales">
          <span><span class="mark-subject">sujet</span> jaune</span>
          <span><span class="mark-verb">werden conjugué</span> rouge</span>
          <span><span class="mark-verbal-tail">infinitif</span> violet</span>
        </div>

        <section class="core-lab" data-core-lab aria-labelledby="future-lab-title">
          <div>
            <p class="core-section-label">Atelier</p>
            <h2 id="future-lab-title">Conjugue <span lang="de">werden</span></h2>
            <div class="core-choice-list core-choice-grid" role="group" aria-label="Choisir le sujet du futur">
              {
                futureLabRows.map((row, index) => (
                  <button
                    type="button"
                    data-core-choice
                    data-subject={row.subject}
                    data-verb={row.form}
                    data-tail={row.tail}
                    data-note={row.note}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                  >
                    {row.label}
                  </button>
                ))
              }
            </div>
          </div>
          <div class="core-stage" data-core-example aria-live="polite">
            <p class="core-stage-kicker">Projection vers l’avenir</p>
            <p class="core-stage-sentence" lang="de">
              <span class="mark-subject" data-core-output="subject">Ich</span>{' '}
              <span class="mark-verb" data-core-output="verb">werde</span>{' '}
              <span class="mark-verbal-tail" data-core-output="tail">nach Berlin reisen.</span>
            </p>
            <p class="core-stage-note" data-core-output="note">werden prend la forme werde avec ich.</p>
          </div>
        </section>

        <section class="core-card" aria-labelledby="future-table-title">
          <div class="core-heading-row">
            <div>
              <p class="core-section-label">Auxiliaire</p>
              <h2 id="future-table-title"><span lang="de">werden</span> au présent</h2>
            </div>
            <p>L’infinitif placé à la fin reste toujours invariable.</p>
          </div>
          <div class="core-table-scroll" role="region" aria-label="Conjugaison de werden" tabindex="0">
            <table class="core-table core-table-compact">
              <caption>Formes de werden utilisées pour le futur I</caption>
              <thead>
                <tr>
                  <th scope="col">Sujet</th>
                  <th scope="col">Forme</th>
                </tr>
              </thead>
              <tbody>
                {
                  futureRows.map((row) => (
                    <tr>
                      <th scope="row"><span class="mark-subject">{row.person}</span></th>
                      <td><strong class="mark-verb" lang="de">{row.form}</strong></td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        <section aria-labelledby="future-contrasts-title">
          <div class="core-heading-row">
            <div>
              <p class="core-section-label">Choisir la bonne forme</p>
              <h2 id="future-contrasts-title">Le futur n’est pas toujours obligatoire</h2>
            </div>
          </div>
          <div class="core-contrast-grid">
            <article class="core-contrast-card">
              <strong>Projet déjà daté</strong>
              <p lang="de"><span class="mark-time">Morgen</span> <span class="mark-verb">reise</span> ich nach Berlin.</p>
              <small>Le présent est souvent le plus naturel quand le moment est clair.</small>
            </article>
            <article class="core-contrast-card">
              <strong>Projection ou prédiction</strong>
              <p lang="de">Ich <span class="mark-verb">werde</span> später im Ausland <span class="mark-verbal-tail">arbeiten</span>.</p>
              <small>Le Futur I met l’avenir ou la prévision au premier plan.</small>
            </article>
            <article class="core-contrast-card">
              <strong><span lang="de">werden</span> peut signifier « devenir »</strong>
              <p lang="de">Mia <span class="mark-verb">wird</span> Ärztin.</p>
              <small>Sans infinitif final, cette phrase n’est pas au Futur I.</small>
            </article>
          </div>
        </section>

        <div class="core-example-pair" aria-label="Comparer werden comme verbe et comme auxiliaire">

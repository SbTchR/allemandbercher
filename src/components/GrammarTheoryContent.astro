---
import {
  declensionTables,
  externalLinkGroups,
  genitiveTable,
  prepositionTables,
  type GrammarTheoryPageSlug,
} from '../data/grammarTheory';
import { withBase } from '../lib/paths';
import GrammarMatrix from './GrammarMatrix.astro';

type Props = {
  slug: GrammarTheoryPageSlug;
};

const { slug } = Astro.props;
const linkGroups = externalLinkGroups[slug] ?? [];
const isCases = slug === 'les-cas-theorie-de-base';
const isDeclensions = slug === 'tableaux-de-declinaisons';
const isPrepositions = slug === 'les-prepositions';
const isGenitive = slug === 'le-genitif';
---

<div class="grammar-page">
  {
    isCases && (
      <>
        <section
          class="case-role-legend"
          aria-label="Les trois cas de base"
          data-source-image-replacement="schéma des trois cas de base"
        >
          <article class="case-role-card case-role-card-nominative">
            <strong>Nominatif</strong>
            <p>Le sujet : qui fait l’action ?</p>
          </article>
          <article class="case-role-card case-role-card-accusative">
            <strong>Accusatif</strong>
            <p>Souvent le CVD : qui ou quoi ?</p>
          </article>
          <article class="case-role-card case-role-card-dative">
            <strong>Datif</strong>
            <p>Souvent le CVI : à qui ou à quoi ?</p>
          </article>
        </section>

        <section class="grammar-core-section" aria-labelledby="case-example-title">
          <h2 id="case-example-title">Une phrase, trois cas</h2>
          <p>
            Un groupe nominal peut contenir un <span class="mark-determiner">déterminant</span>, un{' '}
            <span class="mark-adjective">adjectif</span> et un nom. Sa forme dépend de son rôle dans la phrase.
          </p>

          <div
            class="sentence-lab"
            aria-label="Phrase allemande analysée"
            data-source-image-replacement="phrase allemande analysée par groupes"
          >
            <p>
              Heute <span class="case-chip case-chip-verb">schickt</span>{' '}
              <span class="case-chip case-chip-nominative">Mia</span>{' '}
              <span class="case-chip case-chip-dative">ihrer Freundin</span>{' '}
              <span class="case-chip case-chip-accusative">einen Brief</span>.
            </p>
            <p>Aujourd’hui, Mia envoie une lettre à son amie.</p>
          </div>

          <div class="mini-table-grid" data-source-image-replacement="rôles des trois groupes nominaux">
            <article>
              <strong>Mia</strong>
              <p>fait l’action : nominatif.</p>
            </article>
            <article>
              <strong>einen Brief</strong>
              <p>Mia envoie quoi ? Accusatif.</p>
            </article>
            <article>
              <strong>ihrer Freundin</strong>
              <p>Mia envoie la lettre à qui ? Datif.</p>
            </article>
          </div>

          <div class="grammar-callout" data-source-image-replacement="préposition et cas du groupe nominal">
            <strong>Et après une préposition ?</strong>
            <p>
              La préposition choisit le cas : <span class="case-chip case-chip-preposition">mit</span>{' '}
              <span class="case-chip case-chip-dative">meinem Freund</span>, mais{' '}
              <span class="case-chip case-chip-preposition">für</span>{' '}
              <span class="case-chip case-chip-accusative">meinen Freund</span>.
            </p>
            <a href={withBase('/theorie/grammaire/les-prepositions/')}>Revoir les prépositions</a>
          </div>

          <GrammarMatrix table={declensionTables.shortcut} compact />

          <div class="case-tool-callout">
            <div>
              <strong>Deux outils pour continuer</strong>
              <p>Utilise la NAD-Maschine pour raisonner ou consulte les tableaux complets.</p>
            </div>
            <div class="chapter-actions">
              <a class="case-tool-link" href={withBase('/outils-en-ligne/nad-maschine/')}>NAD-Maschine</a>
              <a class="case-tool-link" href={withBase('/theorie/grammaire/tableaux-de-declinaisons/')}>Tableaux complets</a>
            </div>
          </div>
        </section>

        <details class="lesson-card">
          <summary>Méthode : repérer les groupes</summary>
          <div class="lesson-card-content">
            <ol class="grammar-steps">
              <li>
                <span>Verbe</span>
                <strong>schickt</strong>
                <small>Commence par le mot conjugué.</small>
              </li>
              <li>
                <span>Sujet</span>
                <strong>Mia</strong>
                <small>Qui est-ce qui envoie ?</small>
              </li>
              <li>
                <span>CVD</span>
                <strong>einen Brief</strong>
                <small>Mia envoie quoi ?</small>
              </li>
              <li>
                <span>CVI</span>
                <strong>ihrer Freundin</strong>
                <small>Mia envoie une lettre à qui ?</small>
              </li>
            </ol>
            <p>
              En 9H, il faut surtout maîtriser les déterminants et les pronoms personnels. Les déclinaisons des
              adjectifs sont approfondies en 10H.
            </p>
          </div>
        </details>
      </>
    )
  }

  {
    isDeclensions && (
      <>
        <section class="chapter-dashboard grammar-dashboard" aria-label="Méthode pour choisir une déclinaison">
          <article>
            <strong>1. Genre</strong>
            <p>Masculin, neutre, féminin ou pluriel.</p>
          </article>
          <article>
            <strong>2. Cas</strong>
            <p>Nominatif, accusatif ou datif.</p>
          </article>
          <article>
            <strong>3. Forme</strong>
            <p>Lis la case et observe la terminaison.</p>
          </article>
        </section>

        <nav class="grammar-table-jump-links" aria-label="Accès rapide aux tableaux">
          <a href="#declension-determiners">Déterminants</a>
          <a href="#declension-adjectives">Adjectifs</a>
          <a href="#declension-pronouns">Pronoms personnels</a>
        </nav>

        <section class="grammar-table-section" id="declension-determiners" aria-labelledby="declension-determiners-title">
          <h2 id="declension-determiners-title">Les déterminants</h2>
          <p>
            Le modèle <strong>ein</strong> sert aussi pour <strong>kein</strong> et les possessifs : mein, dein, sein,
            ihr, unser et euer.
          </p>
          <div class="grammar-table-stack">
            <GrammarMatrix table={declensionTables.definiteDeterminers} />
            <GrammarMatrix table={declensionTables.possessiveDeterminers} />
          </div>
        </section>

        <section class="grammar-table-section" id="declension-adjectives" aria-labelledby="declension-adjectives-title">
          <h2 id="declension-adjectives-title">Les adjectifs</h2>
          <p>
            L’adjectif se place entre le déterminant et le nom. Les terminaisons soulignées sont les éléments à
            comparer.
          </p>
          <div class="grammar-table-stack">
            <GrammarMatrix table={declensionTables.adjectiveAfterDefinite} />
            <GrammarMatrix table={declensionTables.adjectiveAfterPossessive} />
          </div>
        </section>

        <section class="grammar-table-section" id="declension-pronouns" aria-labelledby="declension-pronouns-title">
          <h2 id="declension-pronouns-title">Les pronoms personnels</h2>
          <p>Un pronom remplace un groupe nominal : ich devient mich à l’accusatif et mir au datif.</p>
          <GrammarMatrix table={declensionTables.personalPronouns} />
        </section>

        <details class="lesson-card">
          <summary>Deux pièges à connaître</summary>
          <div class="lesson-card-content">
            <ul class="mission-list">
              <li>
                Devant une terminaison, <strong>euer</strong> perd souvent son deuxième <strong>e</strong> :
                eure, euren, eurem.
              </li>
              <li>
                Au datif pluriel, le nom reçoit généralement un <strong>-n</strong> supplémentaire :
                mit den Freunden, mit den roten Schuhen.
              </li>
            </ul>
            <p>
              Ces tableaux couvrent les trois cas de base. Le génitif est présenté sur sa
              <a href={withBase('/theorie/grammaire/le-genitif/')}>page dédiée</a>.
            </p>
          </div>
        </details>
      </>
    )
  }

  {
    isPrepositions && (
      <>
        <section
          class="chapter-dashboard grammar-dashboard"
          aria-label="Les trois familles de prépositions étudiées"
          data-source-image-replacement="synthèse des trois familles de prépositions"
        >
          <article>
            <strong>Accusatif à apprendre</strong>
            <p>durch, für, gegen, ohne, um.</p>
          </article>
          <article>
            <strong>Datif à apprendre</strong>
            <p>aus, bei, mit, nach, seit, von, zu, gegenüber, an … vorbei.</p>
          </article>
          <article>
            <strong>Prépositions mixtes</strong>
            <p><em>wo?</em> + datif ; <em>wohin?</em> + accusatif.</p>
          </article>
        </section>

        <section class="grammar-table-section" aria-labelledby="fixed-prepositions-title">
          <h2 id="fixed-prepositions-title">Les prépositions à cas fixe</h2>
          <p>Pour cette leçon, retiens d’abord ces listes prioritaires : la préposition impose le cas.</p>
          <div class="grammar-table-stack">
            <GrammarMatrix table={prepositionTables.accusative} />
            <GrammarMatrix table={prepositionTables.dative} />
          </div>
        </section>

        <section class="grammar-table-section" aria-labelledby="mixed-prepositions-title">
          <h2 id="mixed-prepositions-title">Les neuf prépositions mixtes</h2>
          <p>
            Avec <strong>an, auf, hinter, in, neben, über, unter, vor</strong> et <strong>zwischen</strong>, pose une
            question précise : <strong>wo?</strong> pour un lieu, <strong>wohin?</strong> pour une direction vers un but.
          </p>

          <div class="movement-switch">
            <article>
              <span class="case-chip case-chip-dative">Lieu — wo ?</span>
              <strong>Das Blatt liegt neben dem Schrank.</strong>
              <p>La feuille se trouve à cet endroit : datif.</p>
            </article>
            <article>
              <span class="case-chip case-chip-accusative">Direction — wohin ?</span>
              <strong>Peter legt das Blatt neben den Schrank.</strong>
              <p>La feuille est dirigée vers un nouvel endroit : accusatif.</p>
            </article>
          </div>

          <GrammarMatrix table={prepositionTables.mixed} />

          <div class="grammar-callout">
            <strong>Le mouvement ne suffit pas.</strong>
            <p>
              Dans <em>Die Kinder laufen im Park</em>, les enfants bougent, mais le parc reste le lieu de l’action :
              <span class="case-chip case-chip-dative">im Park</span>.
            </p>
          </div>
        </section>

        <details class="lesson-card">
          <summary>Verbes utiles pour comparer lieu et direction</summary>
          <div class="lesson-card-content">
            <div class="word-map">
              <span><strong>stellen</strong>poser debout vers un endroit</span>
              <span><strong>stehen</strong>être debout à un endroit</span>
              <span><strong>legen</strong>poser à plat vers un endroit</span>
              <span><strong>liegen</strong>être à plat à un endroit</span>
              <span><strong>hängen + accusatif</strong>accrocher vers un endroit</span>
              <span><strong>hängen + datif</strong>être accroché à un endroit</span>
            </div>
          </div>
        </details>
      </>
    )
  }

  {
    isGenitive && (
      <>
        <section class="chapter-dashboard grammar-dashboard" aria-label="Résumé du génitif">
          <article>
            <strong>Fonction</strong>
            <p>Il indique souvent l’appartenance.</p>
          </article>
          <article>
            <strong>Question</strong>
            <p><em>Wessen?</em> De qui ?</p>
          </article>
          <article>
            <strong>Alternative orale</strong>
            <p><em>von</em> + datif est fréquent.</p>
          </article>
        </section>

        <section class="grammar-table-section" aria-labelledby="genitive-use-title">
          <h2 id="genitive-use-title">Exprimer le possesseur</h2>
          <p>Le groupe qui désigne le possesseur se met au génitif.</p>

          <div class="sentence-lab">
            <p>
              <span>Nom possédé</span> die Jacke
            </p>
            <p>
              <span>Possesseur</span>{' '}
              <span class="case-chip case-chip-genitive">
                <span class="mark-determiner">des</span> <span class="mark-adjective">jungen</span> Mann<span class="mark-ending">es</span>
              </span>
            </p>
            <p>
              Die Jacke <span class="case-chip case-chip-genitive">des jungen Mannes</span> ist blau.
            </p>
          </div>

          <GrammarMatrix table={genitiveTable} />

          <div class="grammar-callout">
            <strong>À l’oral</strong>
            <p>
              On entend souvent <span class="case-chip case-chip-preposition">von</span>{' '}
              <span class="case-chip case-chip-dative">dem jungen Mann</span>, généralement contracté en
              <strong> vom jungen Mann</strong>.
            </p>
          </div>
        </section>

        <details class="lesson-card">
          <summary>Formes particulières à reconnaître</summary>
          <div class="lesson-card-content">
            <ul class="mission-list">
              <li>
                Certains noms masculins faibles prennent <strong>-(e)n</strong> :
                des Jungen, des Präsidenten, des Herrn.
              </li>
              <li>
                Certaines prépositions se construisent souvent avec le génitif :
                während, trotz et wegen.
              </li>
              <li>Les indications comme <strong>links der Strasse</strong> utilisent aussi le génitif.</li>
            </ul>
            <div class="word-map">
              <span><strong>während</strong>während des Tages</span>
              <span><strong>trotz</strong>trotz meiner guten Noten</span>
              <span><strong>wegen</strong>wegen des schlechten Wetters</span>
            </div>
          </div>
        </details>
      </>
    )
  }

  {
    linkGroups.length > 0 && !isCases && (
      <details class="external-quest">
        <summary>Exercices externes supplémentaires</summary>
        <div class="external-link-sections">
          {
            linkGroups.map((group) => (
              <section>
                <h3>{group.title}</h3>
                <div class="external-button-grid">
                  {group.links.map((link) => (
                    <a href={link.url} target="_blank" rel="noreferrer">
                      {link.label}
                    </a>
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </details>
    )
  }
</div>

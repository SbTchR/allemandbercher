---
import type { TheoryEntry } from '../lib/resources';
import { resourceUrl } from '../lib/resources';
import { withBase } from '../lib/paths';

type Category = 'grammaire' | 'syntaxe' | 'conjugaison';

type Props = {
  category: Category;
  entries: TheoryEntry[];
};

type RouteCard = {
  slug: string;
  title: string;
  problem: string;
  example?: string;
};

const { category, entries } = Astro.props;
const entryMap = new Map(entries.map((entry) => [entry.id.split('/').pop()?.replace(/\.md$/, ''), entry]));

const routeCards: Record<Category, RouteCard[]> = {
  grammaire: [
    {
      slug: 'les-pronoms-personnels',
      title: 'Les pronoms personnels',
      problem: 'Remplacer un groupe nominal sans le répéter.',
      example: 'Le chien est gentil, je lui donne un biscuit.',
    },
    {
      slug: 'les-pronoms-possessifs',
      title: 'Les déterminants possessifs',
      problem: 'Indiquer à qui appartient une personne ou un objet.',
      example: 'mon cahier · votre stylo',
    },
    {
      slug: 'les-cas-theorie-de-base',
      title: 'Nominatif, accusatif, datif',
      problem: 'Comprendre le rôle des groupes dans la phrase.',
      example: 'sujet · CVD · CVI',
    },
    {
      slug: 'les-prepositions',
      title: 'Les prépositions',
      problem: 'Choisir le cas demandé après une préposition.',
      example: 'mit + datif · für + accusatif',
    },
    {
      slug: 'tableaux-de-declinaisons',
      title: 'Les tableaux de déclinaisons',
      problem: 'Retrouver la bonne terminaison d’un déterminant ou d’un adjectif.',
      example: 'der · den · dem',
    },
    {
      slug: 'les-adjectifs',
      title: 'Les adjectifs',
      problem: 'Accorder ou décliner correctement un adjectif.',
      example: 'der nette Hund',
    },
    {
      slug: 'le-genitif',
      title: 'Le génitif',
      problem: 'Indiquer l’appartenance ou la possession.',
      example: 'das Auto meines Vaters',
    },
    {
      slug: 'le-comparatif',
      title: 'Le comparatif',
      problem: 'Comparer deux choses ou deux personnes.',
      example: 'plus grand que · aussi petit que',
    },
    {
      slug: 'le-superlatif',
      title: 'Le superlatif',
      problem: 'Comparer un élément à tous les autres.',
      example: 'le plus petit · la plus grande',
    },
  ],
  syntaxe: [
    {
      slug: 'la-place-du-verbe-principal',
      title: 'Phrase affirmative',
      problem: 'Verbe conjugué en 2e position',
    },
    {
      slug: 'les-questions',
      title: 'Questions',
      problem: 'Mot interrogatif ou verbe en premier',
    },
    {
      slug: 'les-phrases-avec-verbe-de-modalite',
      title: 'Verbes de modalité',
      problem: 'Modal en 2e position · infinitif à la fin',
    },
    {
      slug: 'les-phrases-au-passe-compose',
      title: 'Passé composé',
      problem: 'Perfekt · auxiliaire et participe passé',
    },
    {
      slug: 'und-oder-aber-denn-also',
      title: 'und · oder · aber · denn',
      problem: 'L’ordre habituel ne change pas',
    },
    {
      slug: 'trotzdem-deshalb',
      title: 'trotzdem · deshalb · also',
      problem: 'Connecteur, puis verbe conjugué',
    },
    {
      slug: 'weil',
      title: 'weil',
      problem: 'parce que · verbe à la fin',
    },
    {
      slug: 'wenn',
      title: 'wenn',
      problem: 'si / quand · verbe à la fin',
    },
    {
      slug: 'dass',
      title: 'dass',
      problem: 'que · verbe à la fin',
    },
    {
      slug: 'damit-wahrend-bevor-nachdem-als-obwohl',
      title: 'damit · während · bevor · nachdem · als · obwohl',
      problem: 'But, temps ou opposition',
    },
    {
      slug: 'les-infinitives',
      title: 'zu · um … zu · anstatt … zu',
      problem: 'Construire un groupe infinitif',
    },
    {
      slug: 'les-subordonnees-relatives',
      title: 'Relatives',
      problem: 'Préciser un nom · verbe à la fin',
    },
    {
      slug: 'les-questions-indirectes',
      title: 'Questions indirectes',
      problem: 'Rapporter une question · verbe à la fin',
    },
  ],
  conjugaison: [
    {
      slug: 'present',
      title: 'Präsens',
      problem: 'Présent · maintenant ou régulièrement',
    },
    {
      slug: 'preterit',
      title: 'Präteritum',
      problem: 'Prétérit · surtout sein et haben',
    },
    {
      slug: 'passe-compose',
      title: 'Perfekt',
      problem: 'Passé composé · haben/sein + participe',
    },
    {
      slug: 'imperatif',
      title: 'Imperativ',
      problem: 'Impératif · donner une consigne',
    },
    {
      slug: 'futur',
      title: 'Futur I',
      problem: 'Futur · werden + infinitif',
    },
    {
      slug: 'verbes-de-modalite',
      title: 'Modalverben',
      problem: 'Pouvoir, devoir, vouloir…',
    },
    {
      slug: 'les-verbes-reflexifs',
      title: 'Reflexive Verben',
      problem: 'Avec mich, dich, sich…',
    },
    {
      slug: 'konjunktiv-ii',
      title: 'Konjunktiv II',
      problem: 'Souhait, hypothèse ou politesse',
    },
  ],
};

const configuredCards = routeCards[category];
const configuredSlugs = new Set(configuredCards.map((card) => card.slug));
const fallbackCards: RouteCard[] = entries
  .map((entry) => ({
    entry,
    slug: entry.id.split('/').pop()?.replace(/\.md$/, ''),
  }))
  .filter(({ slug }) => Boolean(slug) && !configuredSlugs.has(slug as string))
  .map(({ entry, slug }) => ({
    slug: slug as string,
    title: entry.data.title,
    problem: entry.data.description || 'Ouvrir cette fiche de théorie.',
  }));
const cards = [...configuredCards, ...fallbackCards];
const grammarGroups = [
  {
    title: 'Comprendre les cas',
    note: 'Pour choisir le bon déterminant ou la bonne terminaison.',
    slugs: ['les-cas-theorie-de-base', 'les-prepositions', 'tableaux-de-declinaisons', 'le-genitif'],
  },
  {
    title: 'Remplacer et indiquer la possession',
    note: 'Pour éviter les répétitions et dire à qui appartient quelque chose.',
    slugs: ['les-pronoms-personnels', 'les-pronoms-possessifs'],
  },
  {
    title: 'Décrire et comparer',
    note: 'Pour accorder un adjectif et construire une comparaison.',
    slugs: ['les-adjectifs', 'le-comparatif', 'le-superlatif'],
  },
];
const groupedGrammarSlugs = new Set(grammarGroups.flatMap((group) => group.slugs));
const otherGrammarCards = cards.filter((card) => !groupedGrammarSlugs.has(card.slug));
const syntaxGroups = [
  {
    number: '1',
    title: 'Construire une phrase',
    note: 'Choisis la construction.',
    tone: 'build',
    slugs: [
      'la-place-du-verbe-principal',
      'les-questions',
      'les-phrases-avec-verbe-de-modalite',
      'les-phrases-au-passe-compose',
    ],
  },
  {
    number: '2',
    title: 'Relier deux phrases',
    note: 'Choisis le bon lien.',
    tone: 'connect',
    slugs: ['und-oder-aber-denn-also', 'trotzdem-deshalb'],
  },
  {
    number: '3',
    title: 'Verbe à la fin',
    note: 'Repère la conjonction.',
    tone: 'verb-end',
    slugs: ['weil', 'wenn', 'dass', 'damit-wahrend-bevor-nachdem-als-obwohl'],
  },
  {
    number: '4',
    title: 'Structures avancées',
    note: 'Pour aller plus loin.',
    tone: 'advanced',
    slugs: ['les-infinitives', 'les-subordonnees-relatives', 'les-questions-indirectes'],
  },
] as const;
const conjugationGroups = [
  {
    number: '1',
    title: 'Conjuguer maintenant',
    note: 'Sujet, consigne ou type de verbe.',
    tone: 'now',
    slugs: ['present', 'imperatif', 'verbes-de-modalite', 'les-verbes-reflexifs'],
  },
  {
    number: '2',
    title: 'Situer dans le temps',
    note: 'Passé ou futur.',
    tone: 'time',
    slugs: ['passe-compose', 'preterit', 'futur'],
  },
  {
    number: '3',
    title: 'Exprimer l’irréel',
    note: 'Souhait, hypothèse ou politesse.',
    tone: 'irrealis',
    slugs: ['konjunktiv-ii'],
  },
] as const;
---

{
  category === 'grammaire' && (
    <>
      <section class="content-band theory-route-section grammar-route-section" aria-labelledby="grammaire-problem-title">
        <div class="section-heading">
          <div>
            <p class="home-section-label">Toutes les fiches</p>
            <h2 id="grammaire-problem-title">Que veux-tu comprendre&nbsp;?</h2>
          </div>
          <a class="text-link" href={withBase('/outils-en-ligne/nad-maschine/')}>Ouvrir la NAD-Maschine</a>
        </div>

        <div class="grammar-route-groups">
          {
            grammarGroups.map((group) => (
              <section class="grammar-route-group" aria-labelledby={`grammar-group-${group.slugs[0]}`}>
                <header>
                  <h3 id={`grammar-group-${group.slugs[0]}`}>{group.title}</h3>
                  <p>{group.note}</p>
                </header>
                <div class="theory-route-grid">
                  {
                    group.slugs.map((slug) => {
                      const card = cards.find((candidate) => candidate.slug === slug);
                      const entry = entryMap.get(slug);
                      if (!card || !entry) return null;
                      return (
                        <a class="theory-route-card" href={resourceUrl(entry)}>
                          <strong>{card.title}</strong>
                          <span>{card.problem}</span>
                          {card.example && <small>{card.example}</small>}
                        </a>
                      );
                    })
                  }
                </div>
              </section>
            ))
          }
          {
            otherGrammarCards.length > 0 && (
              <section class="grammar-route-group" aria-labelledby="grammar-group-other">
                <header>
                  <h3 id="grammar-group-other">Autres fiches</h3>
                  <p>Les nouvelles ressources de grammaire apparaissent automatiquement ici.</p>
                </header>
                <div class="theory-route-grid">
                  {
                    otherGrammarCards.map((card) => {
                      const entry = entryMap.get(card.slug);
                      if (!entry) return null;
                      return (
                        <a class="theory-route-card" href={resourceUrl(entry)}>
                          <strong>{card.title}</strong>
                          <span>{card.problem}</span>
                          {card.example && <small>{card.example}</small>}
                        </a>
                      );
                    })
                  }
                </div>
              </section>
            )
          }
        </div>
      </section>

      <section class="grammar-method" aria-labelledby="grammar-guide-title">
        <div class="grammar-method-copy">
          <p class="home-section-label">La méthode en trois questions</p>
          <h2 id="grammar-guide-title">Avant de choisir une terminaison</h2>
          <ol class="grammar-method-steps">
            <li><strong>Quel est le rôle du groupe ?</strong><span>Sujet, CVD, CVI ou possesseur.</span></li>
            <li><strong>Quel est son genre et son nombre ?</strong><span>Masculin, féminin, neutre ou pluriel.</span></li>
            <li><strong>Quel modèle faut-il suivre ?</strong><span>der, ein, possessif ou pronom.</span></li>
          </ol>
        </div>

        <div class="grammar-method-example">
          <p class="grammar-method-label">Lis les groupes, pas seulement les mots</p>
          <p class="grammar-method-sentence">
            <span class="case-chip case-chip-nominative"><small>Sujet</small><span lang="de">Mia</span></span>
            <span class="case-chip case-chip-verb"><small>Verbe</small><span lang="de">schickt</span></span>
            <span class="case-chip case-chip-dative"><small>CVI · datif</small><span lang="de">ihrer Freundin</span></span>
            <span class="case-chip case-chip-accusative"><small>CVD · accusatif</small><span lang="de">einen Brief</span></span>.
          </p>
          <p class="grammar-method-translation">Mia envoie une lettre à son amie.</p>
          <a href={withBase('/theorie/grammaire/les-cas-theorie-de-base/')}>Voir l’analyse complète <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </>
  )
}

{
  category === 'syntaxe' && (
    <section class="content-band theory-category-guide" aria-labelledby="syntax-guide-title">
      <p class="home-section-label">Repère express</p>
      <h2 id="syntax-guide-title">Le verbe donne la structure</h2>
      <p class="category-guide-lead">
        Cherche d’abord le mot qui relie les idées : il t’indique souvent où placer le verbe.
      </p>

      <div class="syntax-role-legend" aria-label="Code couleur de la syntaxe">
        <span><span class="role-chip mark-subject">sujet</span> jaune</span>
        <span><span class="role-chip mark-verb">verbe conjugué</span> rouge</span>
        <span><span class="role-chip mark-object">complément</span> bleu</span>
        <span><span class="role-chip mark-verbal-tail">forme verbale finale</span> violet</span>
      </div>

      <div class="syntax-two-verb-grid">
        <article>
          <span>Passé composé</span>
          <p>Peter <span class="mark-verb">hat</span> einen Apfel <span class="mark-verbal-tail">gegessen</span>.</p>
          <small>Peter a mangé une pomme · auxiliaire + participe passé</small>
        </article>
        <article>
          <span>Verbe de modalité</span>
          <p>Peter <span class="mark-verb">muss</span> sein Zimmer <span class="mark-verbal-tail">aufräumen</span>.</p>
          <small>Peter doit ranger sa chambre · verbe modal + infinitif</small>
        </article>
      </div>
    </section>
  )
}

{
  category === 'conjugaison' && (
    <section class="conjugation-overview" aria-labelledby="conjugation-guide-title">
      <header class="conjugation-overview__header">
        <h2 id="conjugation-guide-title">Conjuguer le verbe avec son sujet</h2>
        <p>Le verbe change selon le sujet et le temps. Va directement à la fiche dont tu as besoin.</p>
      </header>

      <div class="conjugation-overview__support">
        <section class="conjugation-progress" aria-labelledby="conjugation-progress-title">
          <h3 id="conjugation-progress-title">Progression</h3>
          <div class="conjugation-progress__steps">
            <p><strong>7–8H</strong><span lang="de">Präsens</span></p>
            <p><strong>9H</strong><span lang="de">Imperativ · Perfekt</span></p>
            <p><strong>11H</strong><span lang="de">Futur I · Konjunktiv II</span></p>
          </div>
        </section>

        <aside class="conjugation-tools" aria-labelledby="conjugation-tools-title">
          <div>
            <h3 id="conjugation-tools-title">Réviser les verbes</h3>
            <p>Une liste et des jeux rapides.</p>
          </div>
          <nav aria-label="Outils pour réviser les verbes">
            <a href="https://quizlet.com/355592036/" rel="noreferrer" target="_blank">
              <span><strong>Quizlet</strong><small>Liste de verbes</small></span>
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path d="M5 12h13M13 6l6 6-6 6" />
              </svg>
            </a>
            <a href="https://www.blooket.com/set/62b174c039f42a8920c474b3" rel="noreferrer" target="_blank">
              <span><strong>Blooket</strong><small>Jeux rapides</small></span>
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path d="M5 12h13M13 6l6 6-6 6" />
              </svg>
            </a>
          </nav>
        </aside>
      </div>
    </section>
  )
}

{
  category === 'syntaxe' && (
    <section class="syntax-problem-index" aria-labelledby="syntaxe-problem-title">
      <header class="syntax-problem-index__header">
        <h2 id="syntaxe-problem-title">Quel est ton problème&nbsp;?</h2>
      </header>

      <div class="syntax-route-groups">
        {
          syntaxGroups.map((group) => (
            <section
              class={`syntax-route-group syntax-route-group--${group.tone}`}
              aria-labelledby={`syntax-group-${group.number}`}
            >
              <header class="syntax-route-group__intro">
                <span class="syntax-route-group__number" aria-hidden="true">{group.number}</span>
                <div>
                  <h3 id={`syntax-group-${group.number}`}>{group.title}</h3>
                  <p>{group.note}</p>
                </div>
              </header>

              <div class={`syntax-route-list syntax-route-list--${group.tone}`}>
                {
                  group.slugs.map((slug) => {
                    const card = cards.find((candidate) => candidate.slug === slug);
                    const entry = entryMap.get(slug);
                    if (!card || !entry) return null;

                    const isFeatured = slug === 'weil';
                    const isKeyword = ['weil', 'wenn', 'dass'].includes(slug);
                    const isLong =
                      slug === 'damit-wahrend-bevor-nachdem-als-obwohl' ||
                      slug === 'les-infinitives';
                    const isGermanTitle = [
                      'und-oder-aber-denn-also',
                      'trotzdem-deshalb',
                      'weil',
                      'wenn',
                      'dass',
                      'damit-wahrend-bevor-nachdem-als-obwohl',
                      'les-infinitives',
                    ].includes(slug);

                    return (
                      <a
                        class:list={[
                          'syntax-route-card',
                          isFeatured && 'syntax-route-card--featured',
                          isKeyword && 'syntax-route-card--keyword',
                          isLong && 'syntax-route-card--long',
                        ]}
                        href={resourceUrl(entry)}
                      >
                        <span class="syntax-route-card__copy">
                          <strong lang={isGermanTitle ? 'de' : undefined}>{card.title}</strong>
                          <small>{card.problem}</small>
                        </span>
                        <svg
                          class="syntax-route-card__arrow"
                          viewBox="0 0 24 24"
                          width="24"
                          height="24"
                          aria-hidden="true"
                        >
                          <path d="M5 12h13M13 6l6 6-6 6" />
                        </svg>
                      </a>
                    );
                  })
                }
              </div>
            </section>
          ))
        }
      </div>
    </section>
  )
}

{
  category === 'conjugaison' && (
    <section class="conjugation-problem-index" aria-labelledby="conjugaison-problem-title">
      <header class="conjugation-problem-index__header">
        <h2 id="conjugaison-problem-title">Que veux-tu faire&nbsp;?</h2>
      </header>

      <div class="conjugation-route-groups">
        {
          conjugationGroups.map((group) => (
            <section
              class={`conjugation-route-group conjugation-route-group--${group.tone}`}
              aria-labelledby={`conjugation-group-${group.number}`}
            >
              <header class="conjugation-route-group__intro">
                <span class="conjugation-route-group__number" aria-hidden="true">{group.number}</span>
                <div>
                  <h3 id={`conjugation-group-${group.number}`}>{group.title}</h3>
                  <p>{group.note}</p>
                </div>
              </header>

              <div class={`conjugation-route-list conjugation-route-list--${group.tone}`}>
                {
                  group.slugs.map((slug) => {
                    const card = cards.find((candidate) => candidate.slug === slug);
                    const entry = entryMap.get(slug);
                    if (!card || !entry) return null;

                    return (
                      <a
                        class:list={[
                          'conjugation-route-card',
                          slug === 'konjunktiv-ii' && 'conjugation-route-card--featured',
                        ]}
                        href={resourceUrl(entry)}
                      >
                        <span class="conjugation-route-card__copy">
                          <strong lang="de">{card.title}</strong>
                          <small>{card.problem}</small>
                        </span>
                        <svg
                          class="conjugation-route-card__arrow"
                          viewBox="0 0 24 24"
                          width="24"
                          height="24"
                          aria-hidden="true"
                        >
                          <path d="M5 12h13M13 6l6 6-6 6" />
                        </svg>
                      </a>
                    );
                  })
                }
              </div>
            </section>
          ))
        }
      </div>
    </section>
  )
}

<style>
  .syntax-problem-index {
    display: grid;
    gap: 22px;
    margin-top: 26px;
  }

  .syntax-problem-index__header {
    padding-inline: clamp(4px, 1vw, 12px);
  }

  .syntax-problem-index__header h2 {
    position: relative;
    width: fit-content;
    margin: 0;
    color: #132555;
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    line-height: 1.08;
  }

  .syntax-problem-index__header h2::after {
    position: absolute;
    right: 0;
    bottom: -9px;
    left: 12%;
    height: 3px;
    border-radius: 999px;
    background: #c61b3c;
    content: "";
    transform: rotate(-1deg);
  }

  .syntax-route-groups {
    display: grid;
    gap: 18px;
  }

  .syntax-route-group {
    --syntax-tone: #246cc8;
    --syntax-tone-dark: #174c9a;
    --syntax-tone-soft: #edf6ff;
    display: grid;
    grid-template-columns: minmax(190px, 220px) minmax(0, 1fr);
    gap: clamp(18px, 2.4vw, 30px);
    align-items: stretch;
    padding: clamp(18px, 2.3vw, 26px);
    border: 1px solid color-mix(in srgb, var(--syntax-tone) 15%, transparent);
    border-left: 10px solid var(--syntax-tone);
    border-radius: 18px;
    background: var(--syntax-tone-soft);
  }

  .syntax-route-group--connect {
    --syntax-tone: #d09200;
    --syntax-tone-dark: #815600;
    --syntax-tone-soft: #fff8e6;
  }

  .syntax-route-group--verb-end {
    --syntax-tone: #6741b8;
    --syntax-tone-dark: #4f2c9a;
    --syntax-tone-soft: #f4f1ff;
  }

  .syntax-route-group--advanced {
    --syntax-tone: #087f9e;
    --syntax-tone-dark: #00627c;
    --syntax-tone-soft: #eaf8fb;
  }

  .syntax-route-group__intro {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 12px;
    align-content: center;
  }

  .syntax-route-group__number {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 50%;
    background: var(--syntax-tone);
    box-shadow: inset 0 -3px 0 rgba(15, 26, 49, 0.14);
    color: #fff;
    font-size: 1.05rem;
    font-weight: 950;
  }

  .syntax-route-group__intro h3 {
    margin: 1px 0 8px;
    color: #132555;
    font-size: clamp(1.15rem, 2vw, 1.42rem);
    line-height: 1.15;
  }

  .syntax-route-group__intro p {
    margin: 0;
    color: #43506d;
    font-size: 0.88rem;
    font-weight: 760;
    line-height: 1.35;
  }

  .syntax-route-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .syntax-route-list--connect {

---
import type { TheoryEntry } from '../lib/resources';
import { resourceUrl } from '../lib/resources';
import { withBase } from '../lib/paths';

type Category = 'grammaire' | 'syntaxe' | 'conjugaison';

type Props = {
  category: Category;
  entries: TheoryEntry[];
};

type RouteCard = {
  slug: string;
  title: string;
  problem: string;
  example?: string;
};

const { category, entries } = Astro.props;
const entryMap = new Map(entries.map((entry) => [entry.id.split('/').pop()?.replace(/\.md$/, ''), entry]));

const routeCards: Record<Category, RouteCard[]> = {
  grammaire: [
    {
      slug: 'les-pronoms-personnels',
      title: 'Les pronoms personnels',
      problem: 'Remplacer un groupe nominal sans le répéter.',
      example: 'Le chien est gentil, je lui donne un biscuit.',
    },
    {
      slug: 'les-pronoms-possessifs',
      title: 'Les déterminants possessifs',
      problem: 'Indiquer à qui appartient une personne ou un objet.',
      example: 'mon cahier · votre stylo',
    },
    {
      slug: 'les-cas-theorie-de-base',
      title: 'Nominatif, accusatif, datif',
      problem: 'Comprendre le rôle des groupes dans la phrase.',
      example: 'sujet · CVD · CVI',
    },
    {
      slug: 'les-prepositions',
      title: 'Les prépositions',
      problem: 'Choisir le cas demandé après une préposition.',
      example: 'mit + datif · für + accusatif',
    },
    {
      slug: 'tableaux-de-declinaisons',
      title: 'Les tableaux de déclinaisons',
      problem: 'Retrouver la bonne terminaison d’un déterminant ou d’un adjectif.',
      example: 'der · den · dem',
    },
    {
      slug: 'les-adjectifs',
      title: 'Les adjectifs',
      problem: 'Accorder ou décliner correctement un adjectif.',
      example: 'der nette Hund',
    },
    {
      slug: 'le-genitif',
      title: 'Le génitif',
      problem: 'Indiquer l’appartenance ou la possession.',
      example: 'das Auto meines Vaters',
    },
    {
      slug: 'le-comparatif',
      title: 'Le comparatif',
      problem: 'Comparer deux choses ou deux personnes.',
      example: 'plus grand que · aussi petit que',
    },
    {
      slug: 'le-superlatif',
      title: 'Le superlatif',
      problem: 'Comparer un élément à tous les autres.',
      example: 'le plus petit · la plus grande',
    },
  ],
  syntaxe: [
    {
      slug: 'la-place-du-verbe-principal',
      title: 'Les phrases « normales »',
      problem: 'Placer le verbe conjugué dans une phrase affirmative.',
      example: 'Heute spiele ich Fussball.',
    },
    {
      slug: 'les-questions',
      title: 'Les questions',
      problem: 'Construire une question avec ou sans mot interrogatif.',
      example: 'Wo wohnst du? · Kommst du?',
    },
    {
      slug: 'les-phrases-avec-verbe-de-modalite',
      title: 'Les verbes de modalité',
      problem: 'Placer le verbe modal et l’infinitif.',
      example: 'können · mögen · müssen · dürfen',
    },
    {
      slug: 'les-phrases-au-passe-compose',
      title: 'Les phrases au passé composé',
      problem: 'Placer l’auxiliaire et le participe passé.',
      example: 'j’ai fait · je suis allé',
    },
    {
      slug: 'und-oder-aber-denn-also',
      title: 'Les connecteurs « rien de spécial »',
      problem: 'Relier deux phrases sans changer la place habituelle du verbe.',
      example: 'und · oder · aber · denn',
    },
    {
      slug: 'trotzdem-deshalb',
      title: 'Connecteurs avec inversion',
      problem: 'Placer le verbe juste après le connecteur.',
      example: 'trotzdem · deshalb · also',
    },
    {
      slug: 'weil',
      title: 'Subordonnées avec verbe à la fin',
      problem: 'Donner une raison en envoyant le verbe à la fin.',
      example: 'weil',
    },
    {
      slug: 'wenn',
      title: 'Quand ou si',
      problem: 'Exprimer une condition ou une situation répétée.',
      example: 'wenn',
    },
    {
      slug: 'dass',
      title: 'Dire ce que l’on pense',
      problem: 'Introduire une idée ou une opinion.',
      example: 'dass',
    },
    {
      slug: 'damit-wahrend-bevor-nachdem-als-obwohl',
      title: 'Autres subordonnées',
      problem: 'Exprimer le but, le temps, l’opposition ou la concession.',
      example: 'damit · während · bevor · nachdem · als · obwohl',
    },
    {
      slug: 'les-infinitives',
      title: 'Les subordonnées infinitives',
      problem: 'Construire une proposition avec un infinitif.',
      example: 'zu · um … zu · anstatt … zu',
    },
    {
      slug: 'les-subordonnees-relatives',
      title: 'Les subordonnées relatives',
      problem: 'Ajouter une information sur une personne ou une chose.',
      example: 'la personne qui… · le livre que…',
    },
    {
      slug: 'les-questions-indirectes',
      title: 'Les questions indirectes',
      problem: 'Rapporter une question dans une phrase.',
      example: 'où il habite · ce qu’elle fait',
    },
  ],
  conjugaison: [
    {
      slug: 'present',
      title: 'Le présent',
      problem: 'Conjuguer ce qui se passe maintenant ou régulièrement.',
      example: 'ich spiele · du spielst',
    },
    {
      slug: 'preterit',
      title: 'Le prétérit',
      problem: 'Employer les formes du passé, notamment sein et haben.',
      example: 'ich war · ich hatte',
    },
    {
      slug: 'passe-compose',
      title: 'Le passé composé',
      problem: 'Construire le Perfekt avec haben ou sein.',
      example: 'ich habe gespielt · ich bin gegangen',
    },
    {
      slug: 'imperatif',
      title: 'L’impératif',
      problem: 'Donner un ordre ou une consigne.',
      example: 'Komm! · Kommt! · Kommen Sie!',
    },
    {
      slug: 'futur',
      title: 'Le futur',
      problem: 'Parler de ce qui va se passer.',
      example: 'ich werde lernen',
    },
    {
      slug: 'verbes-de-modalite',
      title: 'Les verbes de modalité',
      problem: 'Exprimer une possibilité, une obligation ou une volonté.',
      example: 'können · müssen · wollen',
    },
    {
      slug: 'les-verbes-reflexifs',
      title: 'Les verbes réflexifs',
      problem: 'Conjuguer un verbe accompagné d’un pronom réfléchi.',
      example: 'ich freue mich',
    },
    {
      slug: 'konjunktiv-ii',
      title: 'Le Konjunktiv II',
      problem: 'Exprimer un souhait, une hypothèse ou une demande polie.',
      example: 'ich hätte gern · ich würde',
    },
  ],
};

const configuredCards = routeCards[category];
const configuredSlugs = new Set(configuredCards.map((card) => card.slug));
const fallbackCards: RouteCard[] = entries
  .map((entry) => ({
    entry,
    slug: entry.id.split('/').pop()?.replace(/\.md$/, ''),
  }))
  .filter(({ slug }) => Boolean(slug) && !configuredSlugs.has(slug as string))
  .map(({ entry, slug }) => ({
    slug: slug as string,
    title: entry.data.title,
    problem: entry.data.description || 'Ouvrir cette fiche de théorie.',
  }));
const cards = [...configuredCards, ...fallbackCards];
const grammarGroups = [
  {
    title: 'Comprendre les cas',
    note: 'Pour choisir le bon déterminant ou la bonne terminaison.',
    slugs: ['les-cas-theorie-de-base', 'les-prepositions', 'tableaux-de-declinaisons', 'le-genitif'],
  },
  {
    title: 'Remplacer et indiquer la possession',
    note: 'Pour éviter les répétitions et dire à qui appartient quelque chose.',
    slugs: ['les-pronoms-personnels', 'les-pronoms-possessifs'],
  },
  {
    title: 'Décrire et comparer',
    note: 'Pour accorder un adjectif et construire une comparaison.',
    slugs: ['les-adjectifs', 'le-comparatif', 'le-superlatif'],
  },
];
const groupedGrammarSlugs = new Set(grammarGroups.flatMap((group) => group.slugs));
const otherGrammarCards = cards.filter((card) => !groupedGrammarSlugs.has(card.slug));
---

{
  category === 'grammaire' && (
    <>
      <section class="content-band theory-route-section grammar-route-section" aria-labelledby="grammaire-problem-title">
        <div class="section-heading">
          <div>
            <p class="home-section-label">Toutes les fiches</p>
            <h2 id="grammaire-problem-title">Que veux-tu comprendre&nbsp;?</h2>
          </div>
          <a class="text-link" href={withBase('/outils-en-ligne/nad-maschine/')}>Ouvrir la NAD-Maschine</a>
        </div>

        <div class="grammar-route-groups">
          {
            grammarGroups.map((group) => (
              <section class="grammar-route-group" aria-labelledby={`grammar-group-${group.slugs[0]}`}>
                <header>
                  <h3 id={`grammar-group-${group.slugs[0]}`}>{group.title}</h3>
                  <p>{group.note}</p>
                </header>
                <div class="theory-route-grid">
                  {
                    group.slugs.map((slug) => {
                      const card = cards.find((candidate) => candidate.slug === slug);
                      const entry = entryMap.get(slug);
                      if (!card || !entry) return null;
                      return (
                        <a class="theory-route-card" href={resourceUrl(entry)}>
                          <strong>{card.title}</strong>
                          <span>{card.problem}</span>
                          {card.example && <small>{card.example}</small>}
                        </a>
                      );
                    })
                  }
                </div>
              </section>
            ))
          }
          {
            otherGrammarCards.length > 0 && (
              <section class="grammar-route-group" aria-labelledby="grammar-group-other">
                <header>
                  <h3 id="grammar-group-other">Autres fiches</h3>
                  <p>Les nouvelles ressources de grammaire apparaissent automatiquement ici.</p>
                </header>
                <div class="theory-route-grid">
                  {
                    otherGrammarCards.map((card) => {
                      const entry = entryMap.get(card.slug);
                      if (!entry) return null;
                      return (
                        <a class="theory-route-card" href={resourceUrl(entry)}>
                          <strong>{card.title}</strong>
                          <span>{card.problem}</span>
                          {card.example && <small>{card.example}</small>}
                        </a>
                      );
                    })
                  }
                </div>
              </section>
            )
          }
        </div>
      </section>

      <section class="grammar-method" aria-labelledby="grammar-guide-title">
        <div class="grammar-method-copy">
          <p class="home-section-label">La méthode en trois questions</p>
          <h2 id="grammar-guide-title">Avant de choisir une terminaison</h2>
          <ol class="grammar-method-steps">
            <li><strong>Quel est le rôle du groupe ?</strong><span>Sujet, CVD, CVI ou possesseur.</span></li>
            <li><strong>Quel est son genre et son nombre ?</strong><span>Masculin, féminin, neutre ou pluriel.</span></li>
            <li><strong>Quel modèle faut-il suivre ?</strong><span>der, ein, possessif ou pronom.</span></li>
          </ol>
        </div>

        <div class="grammar-method-example">
          <p class="grammar-method-label">Lis les groupes, pas seulement les mots</p>
          <p class="grammar-method-sentence">
            <span class="case-chip case-chip-nominative"><small>Sujet</small><span lang="de">Mia</span></span>
            <span class="case-chip case-chip-verb"><small>Verbe</small><span lang="de">schickt</span></span>
            <span class="case-chip case-chip-dative"><small>CVI · datif</small><span lang="de">ihrer Freundin</span></span>
            <span class="case-chip case-chip-accusative"><small>CVD · accusatif</small><span lang="de">einen Brief</span></span>.
          </p>
          <p class="grammar-method-translation">Mia envoie une lettre à son amie.</p>
          <a href={withBase('/theorie/grammaire/les-cas-theorie-de-base/')}>Voir l’analyse complète <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </>
  )
}

{
  category === 'syntaxe' && (
    <section class="content-band theory-category-guide" aria-labelledby="syntax-guide-title">
      <p class="home-section-label">Commence par lire ceci</p>
      <h2 id="syntax-guide-title">L’ordre des mots dans la phrase</h2>
      <p class="category-guide-lead">
        La syntaxe règle la question de l’ordre des mots. En allemand, la difficulté principale consiste à mettre le
        verbe au bon endroit.
      </p>

      <p>On distingue les types de phrases suivants :</p>
      <div class="phrase-type-grid category-phrase-types">
        <article>
          <strong>La phrase affirmative (phrase « normale »)</strong>
          <p>Le verbe conjugué occupe la deuxième position.</p>
        </article>
        <article>
          <strong>La phrase interrogative (question)</strong>
          <p>Le verbe suit le mot interrogatif ou ouvre la question.</p>
        </article>
        <article>
          <strong>La phrase impérative (ordre)</strong>
          <p>Le verbe sert à donner un ordre ou une consigne.</p>
        </article>
        <article>
          <strong>La phrase subordonnée (phrase dans la phrase)</strong>
          <p>Certains connecteurs envoient le verbe conjugué à la fin.</p>
        </article>
      </div>

      <p>Pour chaque type de phrase, il y a des règles différentes concernant la place du verbe.</p>

      <div class="syntax-role-legend" aria-label="Code couleur de la syntaxe">
        <span><span class="role-chip mark-subject">sujet</span> jaune</span>
        <span><span class="role-chip mark-verb">verbe principal</span> rouge</span>
        <span><span class="role-chip mark-object">complément</span> bleu</span>
        <span><span class="role-chip mark-verbal-tail">forme verbale finale</span> violet</span>
      </div>

      <div class="syntax-two-verb-grid">
        <article>
          <span>Passé composé</span>
          <p>Peter <span class="mark-verb">hat</span> einen Apfel <span class="mark-verbal-tail">gegessen</span>.</p>
          <small>Peter a mangé une pomme · auxiliaire + participe passé</small>
        </article>
        <article>
          <span>Verbe de modalité</span>
          <p>Peter <span class="mark-verb">muss</span> sein Zimmer <span class="mark-verbal-tail">aufräumen</span>.</p>
          <small>Peter doit ranger sa chambre · verbe modal + infinitif</small>
        </article>
      </div>

      <div class="category-guide-note">
        <strong>Attention au vocabulaire utilisé</strong>
        <p>Dans ces cas de figure, il y a toujours :</p>
        <ul>
          <li>un verbe principal, celui qui est conjugué avec le sujet ;</li>
          <li>une forme verbale invariable, soit le participe passé ou un verbe à l’infinitif.</li>
        </ul>
        <p>Dans ces cas de figure, il y a toujours un verbe principal et une forme verbale invariable.</p>
        <p>
          Le <span class="mark-verb">verbe principal</span> est toujours celui qui est conjugué avec le sujet. La
          <span class="mark-verbal-tail">forme verbale finale</span> est un infinitif, un participe passé ou une particule
          séparable.
        </p>
        <p>
          <strong>Attention :</strong> lorsqu’on parle de « verbe principal », il s’agit toujours du verbe qui est
          conjugué avec le sujet !
        </p>
      </div>
    </section>
  )
}

{
  category === 'conjugaison' && (
    <section class="content-band theory-category-guide" aria-labelledby="conjugation-guide-title">
      <p class="home-section-label">Repères de progression</p>
      <h2 id="conjugation-guide-title">Conjuguer le verbe avec son sujet</h2>
      <p class="category-guide-lead">
        Le verbe est le cœur de la phrase : plus tu connais de verbes, plus il te sera facile d’écrire des phrases variées
        dans un texte. Commence par apprendre les verbes les plus utilisés au quotidien à l’infinitif, puis apprends à les
        conjuguer aux différents temps verbaux en fonction de ceux que tu as vus en classe.
      </p>

      <p>Pour rappel, tu as appris le présent en 7ème et en 8ème. Ensuite, tu apprends :</p>
      <ul class="advice-checklist">
        <li>l’impératif en début de 9ème ;</li>
        <li>le passé composé en 9ème (2ème semestre) ;</li>
        <li>le futur et le Konjunktiv II en 11ème.</li>
      </ul>

      <div class="conjugation-timeline" aria-label="Progression des temps verbaux">
        <article>
          <span>7–8H</span>
          <strong>Présent</strong>
          <p>Le temps de base à connaître avant les autres.</p>
        </article>
        <article>
          <span>Début 9H</span>
          <strong>Impératif</strong>
          <p>Pour donner un ordre ou une consigne.</p>
        </article>
        <article>
          <span>9H · 2e semestre</span>
          <strong>Passé composé</strong>
          <p>Auxiliaire au présent et participe passé.</p>
        </article>
        <article>
          <span>11H</span>
          <strong>Futur et Konjunktiv II</strong>
          <p>Pour les projets, souhaits et hypothèses.</p>
        </article>
      </div>

      <div class="category-guide-note">
        <strong>Pour apprendre les verbes</strong>
        <p>
          Le site Blooket propose des jeux pour réviser les verbes. Utilise-le surtout pour commencer à les apprendre :
          les questions à choix multiples sont pratiques pour les voir une première fois, mais elles ne suffisent pas
          pour bien apprendre à écrire les mots. Alterne observation, rappel oral et production écrite.
        </p>
        <p>Crée ton compte gratuit sur Blooket, puis ouvre la liste de verbes avec le lien ci-dessous.</p>
        <p>Clique ensuite sur « Solo » pour jouer seul ou sur « Host » pour jouer à plusieurs.</p>
        <div class="category-guide-actions">
          <a href="https://quizlet.com/355592036/" rel="noreferrer" target="_blank">Liste des verbes sur Quizlet</a>
          <a href="https://www.blooket.com/set/62b174c039f42a8920c474b3" rel="noreferrer" target="_blank">
            Réviser sur Blooket
          </a>
        </div>
      </div>
    </section>
  )
}

{
  category !== 'grammaire' && (
    <section class="content-band theory-route-section" aria-labelledby={`${category}-problem-title`}>
      <div class="section-heading">
        <div>
          <p class="home-section-label">Quel est ton problème ?</p>
          <h2 id={`${category}-problem-title`}>Choisis la fiche qui répond à ta question</h2>
        </div>
      </div>

      <div class="theory-route-grid">
        {
          cards.map((card) => {
            const entry = entryMap.get(card.slug);
            if (!entry) return null;
            return (
              <a class="theory-route-card" href={resourceUrl(entry)}>
                <strong>{card.title}</strong>
                <span>{card.problem}</span>
                {card.example && <small>{card.example}</small>}
              </a>
            );
          })
        }
      </div>
    </section>
  )
}

---
import type { TheoryEntry } from '../lib/resources';
import { withBase } from '../lib/paths';

type Props = {
  entries: TheoryEntry[];
};

const { entries } = Astro.props;
const availableCategories = new Set<string>(entries.map((entry) => entry.data.category));

const pathways = [
  {
    category: 'grammaire',
    number: '1',
    eyebrow: 'Accorder',
    title: 'Grammaire',
    question: 'Je ne sais pas accorder ou décliner les mots.',
    topics: ['cas', 'pronoms', 'adjectifs'],
  },
  {
    category: 'syntaxe',
    number: '2',
    eyebrow: 'Organiser',
    title: 'Syntaxe',
    question: 'Je ne sais pas où placer le verbe.',
    topics: ['questions', 'connecteurs', 'subordonnées'],
  },
  {
    category: 'conjugaison',
    number: '3',
    eyebrow: 'Former',
    title: 'Conjugaison',
    question: 'Je ne sais pas former ou utiliser un verbe.',
    topics: ['présent', 'passé', 'modes'],
  },
].filter((pathway) => availableCategories.has(pathway.category));
---

<section class="theory-pathways" aria-labelledby="theory-pathways-title">
  <div class="theory-pathways-heading">
    <p class="home-section-label">Par où commencer ?</p>
    <h2 id="theory-pathways-title">Choisis ce que tu veux comprendre</h2>
  </div>

  <div class="theory-pathway-grid">
    {
      pathways.map((pathway) => (
        <a class={`theory-pathway theory-pathway-${pathway.category}`} href={withBase(`/theorie/${pathway.category}/`)}>
          <span class="theory-pathway-number" aria-hidden="true">{pathway.number}</span>
          <span class="theory-pathway-copy">
            <span class="theory-pathway-eyebrow">{pathway.eyebrow}</span>
            <strong>{pathway.title}</strong>
            <span>{pathway.question}</span>
          </span>
          <span class="theory-pathway-topics" aria-label={`Notions : ${pathway.topics.join(', ')}`}>
            {pathway.topics.map((topic) => <small>{topic}</small>)}
          </span>
          <span class="theory-pathway-arrow" aria-hidden="true">→</span>
        </a>
      ))
    }
  </div>
</section>

<section class="theory-example-strip" aria-labelledby="theory-example-title">
  <div class="theory-example-intro">
    <p class="home-section-label">Un exemple suffit</p>
    <h2 id="theory-example-title">Chaque couleur répond à une question</h2>
    <p>Lis d’abord le verbe, puis repère les groupes de la phrase.</p>
  </div>

  <div class="theory-example-sentence">
    <span class="case-chip case-chip-time">
      <small>Quand ?</small>
      <span lang="de">Heute</span>
    </span>
    <span class="case-chip case-chip-verb">
      <small>Verbe</small>
      <span lang="de">schickt</span>
    </span>
    <span class="case-chip case-chip-nominative">
      <small>Sujet · nominatif</small>
      <span lang="de">das Mädchen</span>
    </span>
    <span class="case-chip case-chip-accusative">
      <small>CVD · accusatif</small>
      <span lang="de">einen Brief</span>
    </span>
  </div>

  <a class="theory-example-link" href={withBase('/theorie/grammaire/les-cas-theorie-de-base/')}>
    Comprendre les cas
    <span aria-hidden="true">→</span>
  </a>
</section>

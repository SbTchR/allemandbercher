---
const scenarios = [
  {
    key: 'size',
    label: 'Taille',
    prompt: 'Peter / Paul / gross',
    adjectiveFr: 'grand',
    different: {
      sentence: 'Peter ist grösser als Paul.',
      sentenceHtml: 'Peter ist <span class="mark-adjective">gr<span class="mark-difference">ö</span>ss<span class="mark-ending">er</span></span> <span class="mark-difference">als</span> Paul.',
      formulaHtml: '<span class="mark-adjective">gross</span> + <span class="mark-ending">-er</span> + <span class="mark-difference">als</span>',
      meaningHtml: 'Peter est <span class="mark-difference">plus</span> <span class="mark-adjective">grand</span> <span class="mark-difference">que</span> Paul.',
    },
    less: {
      sentence: 'Peter ist weniger gross als Paul.',
      sentenceHtml: 'Peter ist <span class="mark-difference">weniger</span> <span class="mark-adjective">gross</span> <span class="mark-difference">als</span> Paul.',
      formulaHtml: '<span class="mark-difference">weniger</span> + <span class="mark-adjective">gross</span> + <span class="mark-difference">als</span>',
      meaningHtml: 'Peter est <span class="mark-difference">moins</span> <span class="mark-adjective">grand</span> <span class="mark-difference">que</span> Paul.',
    },
    equal: {
      sentence: 'Peter ist genauso gross wie Paul.',
      sentenceHtml: 'Peter ist <span class="mark-equality">genauso</span> <span class="mark-adjective">gross</span> <span class="mark-equality">wie</span> Paul.',
      formulaHtml: '<span class="mark-equality">genauso</span> + <span class="mark-adjective">gross</span> + <span class="mark-equality">wie</span>',
      meaningHtml: 'Peter est <span class="mark-equality">aussi</span> <span class="mark-adjective">grand</span> <span class="mark-equality">que</span> Paul.',
    },
  },
  {
    key: 'weather',
    label: 'Température',
    prompt: 'draussen / im Haus / kalt',
    adjectiveFr: 'froid',
    different: {
      sentence: 'Draussen ist es kälter als im Haus.',
      sentenceHtml: 'Draussen ist es <span class="mark-adjective">k<span class="mark-difference">ä</span>lt<span class="mark-ending">er</span></span> <span class="mark-difference">als</span> im Haus.',
      formulaHtml: '<span class="mark-adjective">kalt</span> -> <span class="mark-adjective">k<span class="mark-difference">ä</span>lt</span><span class="mark-ending">er</span> + <span class="mark-difference">als</span>',
      meaningHtml: 'Dehors, il fait <span class="mark-difference">plus</span> <span class="mark-adjective">froid</span> <span class="mark-difference">que</span> dans la maison.',
    },
    less: {
      sentence: 'Draussen ist es weniger kalt als im Haus.',
      sentenceHtml: 'Draussen ist es <span class="mark-difference">weniger</span> <span class="mark-adjective">kalt</span> <span class="mark-difference">als</span> im Haus.',
      formulaHtml: '<span class="mark-difference">weniger</span> + <span class="mark-adjective">kalt</span> + <span class="mark-difference">als</span>',
      meaningHtml: 'Dehors, il fait <span class="mark-difference">moins</span> <span class="mark-adjective">froid</span> <span class="mark-difference">que</span> dans la maison.',
    },
    equal: {
      sentence: 'Draussen ist es genauso kalt wie im Haus.',
      sentenceHtml: 'Draussen ist es <span class="mark-equality">genauso</span> <span class="mark-adjective">kalt</span> <span class="mark-equality">wie</span> im Haus.',
      formulaHtml: '<span class="mark-equality">genauso</span> + <span class="mark-adjective">kalt</span> + <span class="mark-equality">wie</span>',
      meaningHtml: 'Dehors, il fait <span class="mark-equality">aussi</span> <span class="mark-adjective">froid</span> <span class="mark-equality">que</span> dans la maison.',
    },
  },
  {
    key: 'preference',
    label: 'Préférence',
    prompt: 'Tee / Kaffee / gern',
    adjectiveFr: 'volontiers',
    different: {
      sentence: 'Ich mag Tee lieber als Kaffee.',
      sentenceHtml: 'Ich mag Tee <span class="mark-adjective">lieb<span class="mark-ending">er</span></span> <span class="mark-difference">als</span> Kaffee.',
      formulaHtml: '<span class="mark-adjective">gern</span> -> <span class="mark-adjective">lieb</span><span class="mark-ending">er</span> + <span class="mark-difference">als</span>',
      meaningHtml: 'J’aime <span class="mark-difference">plus</span> le thé <span class="mark-difference">que</span> le café.',
    },
    less: {
      sentence: 'Ich mag Tee weniger gern als Kaffee.',
      sentenceHtml: 'Ich mag Tee <span class="mark-difference">weniger</span> <span class="mark-adjective">gern</span> <span class="mark-difference">als</span> Kaffee.',
      formulaHtml: '<span class="mark-difference">weniger</span> + <span class="mark-adjective">gern</span> + <span class="mark-difference">als</span>',
      meaningHtml: 'J’aime <span class="mark-difference">moins</span> le thé <span class="mark-difference">que</span> le café.',
    },
    equal: {
      sentence: 'Ich mag Tee genauso gern wie Kaffee.',
      sentenceHtml: 'Ich mag Tee <span class="mark-equality">genauso</span> <span class="mark-adjective">gern</span> <span class="mark-equality">wie</span> Kaffee.',
      formulaHtml: '<span class="mark-equality">genauso</span> + <span class="mark-adjective">gern</span> + <span class="mark-equality">wie</span>',
      meaningHtml: "J'aime <span class=\"mark-equality\">aussi</span> volontiers le thé <span class=\"mark-equality\">que</span> le café.",
    },
  },
];
---

<section class="content-band comparative-lab" aria-labelledby="comparative-lab-title" data-comparative-lab>
  <div class="comparative-lab-header">
    <div>
      <p class="home-section-label">Mini-labo</p>
      <h2 id="comparative-lab-title">Choisis la bonne comparaison</h2>
      <p>Change la situation et observe comment la phrase allemande se construit.</p>
    </div>
  </div>

  <div class="comparative-lab-grid">
    <div class="comparative-lab-panel" aria-label="Situations">
      <p class="comparative-lab-label">1. Choisis une situation</p>
      <div class="comparative-lab-options">
        {
          scenarios.map((scenario, index) => (
            <button
              class:list={['comparative-lab-card', { 'is-selected': index === 0 }]}
              type="button"
              data-scenario={index}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              <strong>{scenario.label}</strong>
              <span>{scenario.prompt}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="comparative-lab-panel" aria-label="Type de comparaison">
      <p class="comparative-lab-label">2. Choisis le type</p>
      <div class="comparative-lab-toggle">
        <button class="is-selected" type="button" data-mode="different" aria-pressed="true">Plus</button>
        <button type="button" data-mode="equal" aria-pressed="false">Aussi</button>
        <button type="button" data-mode="less" aria-pressed="false">Moins</button>
      </div>
      <p class="comparative-lab-hint" data-lab-hint>plus <span>grand</span> que</p>
    </div>

    <div class="comparative-lab-result" aria-live="polite">
      <p class="comparative-lab-label">3. Observe le résultat</p>
      <p class="comparative-lab-formula" data-lab-formula set:html={scenarios[0].different.formulaHtml}></p>
      <p class="comparative-lab-sentence" data-lab-sentence set:html={scenarios[0].different.sentenceHtml}></p>
      <p class="comparative-lab-meaning" data-lab-meaning set:html={scenarios[0].different.meaningHtml}></p>
    </div>
  </div>
</section>

<script define:vars={{ scenarios }} is:inline>
  const lab = document.querySelector('[data-comparative-lab]');

  if (lab instanceof HTMLElement) {
    const scenarioButtons = Array.from(lab.querySelectorAll('[data-scenario]'));
    const modeButtons = Array.from(lab.querySelectorAll('[data-mode]'));
    const sentence = lab.querySelector('[data-lab-sentence]');
    const formula = lab.querySelector('[data-lab-formula]');
    const meaning = lab.querySelector('[data-lab-meaning]');
    const hint = lab.querySelector('[data-lab-hint]');
    let selectedScenario = 0;
    let selectedMode = 'different';

    const update = () => {
      const current = scenarios[selectedScenario][selectedMode];
      if (sentence) sentence.innerHTML = current.sentenceHtml;
      if (formula) formula.innerHTML = current.formulaHtml;
      if (meaning) meaning.innerHTML = current.meaningHtml;
      if (hint) {
        const adjective = scenarios[selectedScenario].adjectiveFr ?? 'grand';
        const signal = selectedMode === 'different' ? 'plus' : selectedMode === 'less' ? 'moins' : 'aussi';
        const signalClass = selectedMode === 'equal' ? 'mark-equality' : 'mark-difference';
        hint.innerHTML = `<span class="${signalClass}">${signal}</span> <span class="mark-adjective">${adjective}</span> <span class="${signalClass}">que</span>`;
      }

      scenarioButtons.forEach((button, index) => {
        const isSelected = index === selectedScenario;
        button.classList.toggle('is-selected', isSelected);
        button.setAttribute('aria-pressed', String(isSelected));
      });

      modeButtons.forEach((button) => {
        const isSelected = button.dataset.mode === selectedMode;
        button.classList.toggle('is-selected', isSelected);
        button.setAttribute('aria-pressed', String(isSelected));
      });
    };

    scenarioButtons.forEach((button) => {
      button.addEventListener('click', () => {
        selectedScenario = Number(button.dataset.scenario ?? 0);
        update();
      });
    });

    modeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        selectedMode = button.dataset.mode === 'less' ? 'less' : button.dataset.mode === 'equal' ? 'equal' : 'different';
        update();
      });
    });
  }
</script>

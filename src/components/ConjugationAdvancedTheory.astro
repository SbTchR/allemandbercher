<script>
  const setupAdvancedConjugation = () => {
    document.querySelectorAll<HTMLElement>('[data-cav-root]').forEach((root) => {
      if (root.dataset.cavReady === 'true') return;
      root.dataset.cavReady = 'true';

      root.querySelectorAll<HTMLElement>('[data-cav-switcher]').forEach((switcher) => {
        const buttons = Array.from(switcher.querySelectorAll<HTMLButtonElement>('[data-cav-choice]'));
        const panels = Array.from(switcher.querySelectorAll<HTMLElement>('[data-cav-panel]'));

        const activate = (key: string) => {
          buttons.forEach((button) => {
            button.setAttribute('aria-pressed', button.dataset.cavChoice === key ? 'true' : 'false');
          });
          panels.forEach((panel) => {
            panel.hidden = panel.dataset.cavPanel !== key;
          });
        };

        buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const key = button.dataset.cavChoice;
            if (key) activate(key);
          });
        });
      });
    });
  };

  setupAdvancedConjugation();
  document.addEventListener('astro:page-load', setupAdvancedConjugation);
</script>


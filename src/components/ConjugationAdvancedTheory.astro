    title: 'dürfen · avoir le droit',
    formula: [
      { text: 'dürfen', role: 'stem' },
      { text: '→ dürft', role: 'finite' },
    ],
    sentence: [
      { text: 'Ihr', role: 'subject' },
      { text: 'dürft', role: 'finite' },
      { text: 'heute länger' },

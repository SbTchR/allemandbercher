---
type AdvancedConjugationSlug = 'passe-compose' | 'preterit' | 'verbes-de-modalite' | 'konjunktiv-ii';

type Props = {
  slug: AdvancedConjugationSlug;
};

type GrammarRole = 'subject' | 'finite' | 'stem' | 'ending';

type PhrasePiece = {
  text: string;
  role?: GrammarRole;
};

type WorkshopOption = {
  key: string;
  label: string;
  title: string;
  formula: PhrasePiece[];
  sentence: PhrasePiece[];
  note: string;
};

const { slug } = Astro.props;

const roleClasses: Record<GrammarRole, string> = {
  subject: 'cav-subject',
  finite: 'cav-finite',
  stem: 'cav-stem',
  ending: 'cav-ending',
};

const perfectOptions: WorkshopOption[] = [
  {
    key: 'machen',
    label: 'machen',
    title: 'Verbe faible',
    formula: [
      { text: 'ge-', role: 'ending' },
      { text: 'mach', role: 'stem' },
      { text: '-t', role: 'ending' },
    ],
    sentence: [
      { text: 'Mia', role: 'subject' },
      { text: 'hat', role: 'finite' },
      { text: 'die Hausaufgaben' },
      { text: 'gemacht.', role: 'stem' },
    ],
    note: 'Le radical reste stable et le participe se termine par -t.',
  },
  {
    key: 'gehen',
    label: 'gehen',
    title: 'Verbe fort',
    formula: [
      { text: 'ge-', role: 'ending' },
      { text: 'gang', role: 'stem' },
      { text: '-en', role: 'ending' },
    ],
    sentence: [
      { text: 'Wir', role: 'subject' },
      { text: 'sind', role: 'finite' },
      { text: 'nach Hause' },
      { text: 'gegangen.', role: 'stem' },
    ],
    note: 'Le radical change. La forme gegangen doit être mémorisée.',
  },
  {
    key: 'bringen',
    label: 'bringen',
    title: 'Verbe mixte',
    formula: [
      { text: 'ge-', role: 'ending' },
      { text: 'brach', role: 'stem' },
      { text: '-t', role: 'ending' },
    ],
    sentence: [
      { text: 'Noah', role: 'subject' },
      { text: 'hat', role: 'finite' },
      { text: 'den Kuchen' },
      { text: 'gebracht.', role: 'stem' },
    ],
    note: 'Le radical change comme avec un verbe fort, mais la terminaison est -t.',
  },
  {
    key: 'abholen',
    label: 'abholen',
    title: 'Particule séparable',
    formula: [
      { text: 'ab-', role: 'stem' },
      { text: 'ge-', role: 'ending' },
      { text: 'hol', role: 'stem' },
      { text: '-t', role: 'ending' },
    ],
    sentence: [
      { text: 'Ich', role: 'subject' },
      { text: 'habe', role: 'finite' },
      { text: 'Lina' },
      { text: 'abgeholt.', role: 'stem' },
    ],
    note: 'Avec une particule séparable, ge- se glisse entre la particule et le radical.',
  },
  {
    key: 'verlieren',
    label: 'verlieren',
    title: 'Préfixe inséparable',
    formula: [
      { text: 'ver-', role: 'stem' },
      { text: 'lor', role: 'stem' },
      { text: '-en', role: 'ending' },
    ],
    sentence: [
      { text: 'Sie', role: 'subject' },
      { text: 'hat', role: 'finite' },
      { text: 'ihren Schlüssel' },
      { text: 'verloren.', role: 'stem' },
    ],
    note: 'Le préfixe ver- bloque ge-. La forme forte reste à apprendre.',
  },
  {
    key: 'telefonieren',
    label: 'telefonieren',
    title: 'Verbe en -ieren',
    formula: [
      { text: 'telefonier', role: 'stem' },
      { text: '-t', role: 'ending' },
    ],
    sentence: [
      { text: 'Ihr', role: 'subject' },
      { text: 'habt', role: 'finite' },
      { text: 'lange' },
      { text: 'telefoniert.', role: 'stem' },
    ],
    note: 'Les verbes en -ieren ne prennent jamais ge-.',
  },
];

const perfectRows = [
  {
    type: 'Faible',
    pattern: 'ge- + radical + -(e)t',
    example: 'machen → gemacht',
    note: 'Le modèle le plus régulier.',
  },
  {
    type: 'Fort',
    pattern: 'ge- + radical du participe + -en',
    example: 'gehen → gegangen',
    note: 'Le radical change souvent ; la forme s’apprend.',
  },
  {
    type: 'Mixte',
    pattern: 'ge- + radical modifié + -t',
    example: 'bringen → gebracht',
    note: 'Un petit groupe à mémoriser.',
  },
];

const preteritOptions: WorkshopOption[] = [
  {
    key: 'machen',
    label: 'machen',
    title: 'Forme faible',
    formula: [
      { text: 'mach-', role: 'stem' },
      { text: '-te', role: 'ending' },
      { text: '→ machte', role: 'finite' },
    ],
    sentence: [
      { text: 'Gestern' },
      { text: 'machte', role: 'finite' },
      { text: 'Lea', role: 'subject' },
      { text: 'die Hausaufgaben.' },

    sentence: [
      { text: 'Ihr', role: 'subject' },
      { text: 'asst', role: 'finite' },
      { text: 'zusammen.' },
    ],
    note: 'En Suisse : ich ass, du assest, ihr asst.',
  },
];

const preteritRows = [
  ['ich', 'machte', 'war', 'hatte', 'fuhr', 'ass'],
  ['du', 'machtest', 'warst', 'hattest', 'fuhrst', 'assest'],
  ['er / sie / es', 'machte', 'war', 'hatte', 'fuhr', 'ass'],
  ['wir', 'machten', 'waren', 'hatten', 'fuhren', 'assen'],
  ['ihr', 'machtet', 'wart', 'hattet', 'fuhrt', 'asst'],
  ['sie / Sie', 'machten', 'waren', 'hatten', 'fuhren', 'assen'],

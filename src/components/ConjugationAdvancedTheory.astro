  {
    key: 'sein',
    label: 'sein',
    title: 'Le verbe le plus utile',
    formula: [
      { text: 'war', role: 'finite' },
      { text: '· warst · waren', role: 'stem' },
    ],
    sentence: [
      { text: 'Am Montag' },
      { text: 'war', role: 'finite' },
      { text: 'ich', role: 'subject' },
      { text: 'krank.' },
    ],

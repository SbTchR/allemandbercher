  {
    key: 'necessity',
    label: 'nécessité',
    title: 'müssen · être obligé',
    formula: [
      { text: 'müssen', role: 'stem' },
      { text: '→ muss', role: 'finite' },
    ],
    sentence: [
      { text: 'Lina', role: 'subject' },
      { text: 'muss', role: 'finite' },
      { text: 'für den Test' },
      { text: 'lernen.', role: 'stem' },
    ],
    note: 'müssen exprime une nécessité ou une obligation.',

---
const items = [
  {
    prompt: 'Après l’école, nous jouons au football.',
    options: [
      'Nach der Schule wir spielen Fussball.',
      'Nach der Schule spielen wir Fussball.',
      'Nach spielen der Schule wir Fussball.',
    ],
    answer: 1,
    hint: 'Nach der Schule forme tout le premier groupe. Le verbe conjugué vient juste après.',
    solution:
      '<span class="mark-time">Nach der Schule</span> <span class="mark-verb">spielen</span> <span class="mark-subject">wir</span> Fussball.',
  },
  {
    prompt: 'Aujourd’hui, Anna veut lire ce livre.',
    options: [
      'Heute Anna will dieses Buch lesen.',
      'Heute will Anna lesen dieses Buch.',
      'Heute will Anna dieses Buch lesen.',
    ],
    answer: 2,
    hint: 'Le modal conjugué occupe la position 2 et l’infinitif reste à la fin.',
    solution:
      '<span class="mark-time">Heute</span> <span class="mark-verb">will</span> <span class="mark-subject">Anna</span> dieses Buch <span class="mark-verbal-tail">lesen</span>.',
  },
  {
    prompt: 'Hier, l’élève a oublié son livre.',
    options: [
      'Gestern hat der Schüler sein Buch vergessen.',
      'Gestern der Schüler hat sein Buch vergessen.',
      'Gestern hat vergessen der Schüler sein Buch.',
    ],
    answer: 0,
    hint: 'L’auxiliaire conjugué est en position 2 ; le participe passé ferme la phrase.',
    solution:
      '<span class="mark-time">Gestern</span> <span class="mark-verb">hat</span> <span class="mark-subject">der Schüler</span> sein Buch <span class="mark-verbal-tail">vergessen</span>.',
  },
];
---

<section
  class="content-band theory-practice-suite"
  aria-labelledby="verb-position-practice-title"
  data-verb-position-practice
>
  <div class="theory-practice-hero">
    <div>
      <p class="home-section-label">Exercice intégré</p>
      <h2 id="verb-position-practice-title">Garde le verbe à sa place</h2>
      <p>Trois phrases suffisent pour vérifier le réflexe de la position 2.</p>
    </div>
    <span>9H</span>
  </div>

  <article class="theory-activity">
    <div class="theory-activity-head">
      <div>
        <p class="theory-activity-kicker">Choix guidé</p>
        <h3>Choisis la phrase bien construite</h3>
        <p>Valide chaque situation séparément. Le corrigé reste caché jusqu’à ta tentative.</p>
      </div>
      <output data-verb-position-score aria-live="polite">0 / {items.length}</output>
    </div>

    <div class="theory-item-grid">
      {
        items.map((item, itemIndex) => (
          <section
            class="theory-practice-item"
            data-verb-position-item
            data-answer={item.answer}
            data-hint={item.hint}
          >
            <p class="theory-item-prompt">
              <strong>{itemIndex + 1}.</strong> {item.prompt}
            </p>
            <div class="theory-choice-row" role="group" aria-label={`Réponses pour la phrase ${itemIndex + 1}`}>
              {
                item.options.map((option, optionIndex) => (
                  <button type="button" data-verb-position-choice={optionIndex} aria-pressed="false">
                    {option}
                  </button>
                ))
              }
            </div>
            <div class="theory-feedback-row">
              <button class="text-link" type="button" data-show-verb-position-solution hidden>
                Voir le corrigé
              </button>
              <p data-verb-position-feedback aria-live="polite"></p>
            </div>
            <p class="theory-built-sentence" data-verb-position-solution hidden set:html={item.solution}></p>
          </section>
        ))
      }
    </div>

    <div class="theory-action-row theory-suite-actions">
      <button class="text-link" type="button" data-reset-verb-position-practice>Recommencer</button>
    </div>
  </article>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-verb-position-practice]').forEach((practice) => {
    const items = Array.from(practice.querySelectorAll<HTMLElement>('[data-verb-position-item]'));
    const score = practice.querySelector<HTMLOutputElement>('[data-verb-position-score]');

    const updateScore = () => {
      const correct = items.filter((item) => item.dataset.state === 'correct').length;
      if (score) score.textContent = `${correct} / ${items.length}`;
    };

    items.forEach((item) => {
      const answer = Number(item.dataset.answer ?? -1);
      const choices = Array.from(item.querySelectorAll<HTMLButtonElement>('[data-verb-position-choice]'));
      const feedback = item.querySelector<HTMLElement>('[data-verb-position-feedback]');
      const revealButton = item.querySelector<HTMLButtonElement>('[data-show-verb-position-solution]');
      const solution = item.querySelector<HTMLElement>('[data-verb-position-solution]');

      choices.forEach((button) => {
        button.addEventListener('click', () => {
          const isCorrect = Number(button.dataset.verbPositionChoice ?? -1) === answer;

          choices.forEach((choice) => {
            choice.classList.remove('is-correct', 'is-wrong');
            choice.setAttribute('aria-pressed', String(choice === button));
          });
          button.classList.add(isCorrect ? 'is-correct' : 'is-wrong');
          item.dataset.state = isCorrect ? 'correct' : 'wrong';

          if (feedback) {
            feedback.textContent = isCorrect
              ? 'Correct : le verbe conjugué occupe le deuxième groupe.'
              : item.dataset.hint ?? 'Réessaie.';
            feedback.classList.toggle('is-correct', isCorrect);
            feedback.classList.toggle('is-wrong', !isCorrect);
          }
          if (revealButton) revealButton.hidden = false;
          if (solution) solution.hidden = true;
          updateScore();
        });
      });

      revealButton?.addEventListener('click', () => {
        if (solution) solution.hidden = false;
        revealButton.hidden = true;
      });
    });

    practice.querySelector('[data-reset-verb-position-practice]')?.addEventListener('click', () => {
      items.forEach((item) => {
        item.removeAttribute('data-state');
        item.querySelectorAll<HTMLButtonElement>('[data-verb-position-choice]').forEach((choice) => {
          choice.classList.remove('is-correct', 'is-wrong');
          choice.setAttribute('aria-pressed', 'false');
        });
        const feedback = item.querySelector<HTMLElement>('[data-verb-position-feedback]');
        const revealButton = item.querySelector<HTMLButtonElement>('[data-show-verb-position-solution]');
        const solution = item.querySelector<HTMLElement>('[data-verb-position-solution]');
        if (feedback) {
          feedback.textContent = '';
          feedback.classList.remove('is-correct', 'is-wrong');
        }
        if (revealButton) revealButton.hidden = true;
        if (solution) solution.hidden = true;
      });
      updateScore();
      practice.querySelector<HTMLButtonElement>('[data-verb-position-choice]')?.focus();
    });

    updateScore();
  });
</script>
